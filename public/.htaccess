RewriteRule ^iso-27001/?$ /management-system/iso-27001/ [R=301,L]
RewriteRule ^iso-28000/?$ /management-system/iso-28000/ [R=301,L]
RewriteRule ^iso-37001/?$ /management-system/iso-37001/ [R=301,L]
RewriteRule ^non-gmo-animal-feed/?$ /food-certification/non-gmo-animal-feed/ [R=301,L]

# Deleted duplicate management-system ISO 22000 page -> food-certification canonical
RewriteRule ^management-system/iso-22000/?$ /food-certification/iso-22000/ [R=301,L]

RewriteRule ^wp-login\.php$ / [R=301,L]

# Serve existing files and folders as-is
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve folder index.html for clean URLs
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Fallback to route index.html (Next.js static export)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

ErrorDocument 404 /404.html

