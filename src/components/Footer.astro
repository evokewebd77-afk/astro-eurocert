---
---
<footer class="footer-premium">
  <div class="container mx-auto px-6 text-center md:text-left">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10">

      <div class="lg:col-span-1">
        <a href="/" class="inline-block group">
          <img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto,w_720/c_limit,f_auto,q_auto:good,dpr_auto,w_256/v1782367859/eurocert/Untitled_design_19_.png.png" alt="EUROCERT Logo" class="h-16 w-auto mx-auto md:mx-0 mb-3 drop-shadow-[0_0_15px_rgba(212,168,67,0.4)] group-hover:drop-shadow-[0_0_25px_rgba(212,168,67,0.7)] transition-all duration-500 group-hover:scale-105" />
        </a>
        <p class="text-white/50 text-sm leading-relaxed max-w-xs mx-auto md:mx-0">
          Eurocert Inspection Services is a leading independent certification and inspection body, helping businesses meet global standards with trusted audits and internationally recognised certifications.
        </p>
      </div>

      <div>
        <h4 class="heading-font text-[10px] font-bold uppercase tracking-widest text-eurogold-400 mb-4">Expertise</h4>
        <ul class="space-y-2">
          <li><a href="/ce-certification" class="text-white/50 hover:text-eurogold-400 text-xs transition">CE Certification</a></li>
          <li><a href="/social-audits" class="text-white/50 hover:text-eurogold-400 text-xs transition">Social Responsibility</a></li>
          <li><a href="/food-certification" class="text-white/50 hover:text-eurogold-400 text-xs transition">Food Safety</a></li>
          <li><a href="/sustainability" class="text-white/50 hover:text-eurogold-400 text-xs transition">Sustainability</a></li>
          <li><a href="/training" class="text-white/50 hover:text-eurogold-400 text-xs transition">Training</a></li>
        </ul>
      </div>

      <div>
        <h4 class="heading-font text-[10px] font-bold uppercase tracking-widest text-eurogold-400 mb-4">Policies &amp; Resources</h4>
        <ul class="space-y-2">
          <li><a href="/foundation" class="text-white/50 hover:text-eurogold-400 text-xs transition">Foundation</a></li>
          <li><a href="/child-labour-policy" class="text-white/50 hover:text-eurogold-400 text-xs transition">Child Labour Policy</a></li>
          <li><a href="/forced-labour-policy" class="text-white/50 hover:text-eurogold-400 text-xs transition">Forced Labour Policy</a></li>
          <li><a href="/quality-policy" class="text-white/50 hover:text-eurogold-400 text-xs transition">Quality Policy</a></li>
          <li><a href="/privacy-policy" class="text-white/50 hover:text-eurogold-400 text-xs transition">Privacy Policy</a></li>
          <li><a href="/certified-clients" class="text-white/50 hover:text-eurogold-400 text-xs transition">Clients</a></li>
          <li><a href="/product-catalogue" class="text-white/50 hover:text-eurogold-400 text-xs transition">Product Catalogue</a></li>
          <li><a href="/grievance" class="text-white/50 hover:text-eurogold-400 text-xs transition">Grievance</a></li>
        </ul>
      </div>

      <div>
        <h4 class="heading-font text-[10px] font-bold uppercase tracking-widest text-eurogold-400 mb-4">Connect</h4>
        <ul class="space-y-2 text-xs text-white/50">
          <li class="flex items-start justify-center md:justify-start gap-3">
            <i class="fas fa-map-marker-alt text-eurogold-400 mt-0.5 shrink-0"></i>
            Panchkula, Haryana, India
          </li>
          <li class="flex items-center justify-center md:justify-start gap-3">
            <i class="fas fa-phone text-eurogold-400 shrink-0"></i>
            +91 9316012883
          </li>
          <li class="flex items-start justify-center md:justify-start gap-3">
            <i class="fas fa-envelope text-eurogold-400 shrink-0 mt-0.5"></i>
            <span class="text-left space-y-1">
              <a href="mailto:eurocert.mv@gmail.com" class="block hover:text-eurogold-400 transition-colors break-all">eurocert.mv@gmail.com</a>
              <a href="mailto:info@eurocert.in" class="block hover:text-eurogold-400 transition-colors break-all">info@eurocert.in</a>
            </span>
          </li>
          <li class="flex items-center justify-center md:justify-start gap-2 pt-1">
            <a href="https://www.facebook.com/people/Eurocert-Inspection-Services-Pvt-Ltd/100095339032882/" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-white/5 border border-eurogold-400/30 flex items-center justify-center text-eurogold-400 hover:border-eurogold-400 hover:bg-eurogold-400/10 transition-all" aria-label="Facebook"><i class="fab fa-facebook-f text-xs"></i></a>
            <a href="https://www.instagram.com/euro_cert/" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-white/5 border border-eurogold-400/30 flex items-center justify-center text-eurogold-400 hover:border-eurogold-400 hover:bg-eurogold-400/10 transition-all" aria-label="Instagram"><i class="fab fa-instagram text-xs"></i></a>
            <a href="https://www.linkedin.com/company/eurocert-inspection-services-pvt-ltd/" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-white/5 border border-eurogold-400/30 flex items-center justify-center text-eurogold-400 hover:border-eurogold-400 hover:bg-eurogold-400/10 transition-all" aria-label="LinkedIn"><i class="fab fa-linkedin-in text-xs"></i></a>
            <a href="https://x.com/EUROCERT3" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-white/5 border border-eurogold-400/30 flex items-center justify-center text-eurogold-400 hover:border-eurogold-400 hover:bg-eurogold-400/10 transition-all" aria-label="X (Twitter)"><i class="fab fa-x-twitter text-xs"></i></a>
            <a href="https://www.youtube.com/@eurocert" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-white/5 border border-eurogold-400/30 flex items-center justify-center text-eurogold-400 hover:border-eurogold-400 hover:bg-eurogold-400/10 transition-all" aria-label="YouTube"><i class="fab fa-youtube text-xs"></i></a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="heading-font text-[10px] font-bold uppercase tracking-widest text-eurogold-400 mb-4">Quick Callback</h4>
        <p id="ec-callback-ok" class="text-emerald-400 text-sm hidden"><i class="fas fa-check-circle mr-2"></i>We'll call you back!</p>
        <form id="ec-callback-form" class="space-y-3">
          <input type="text" name="phone" required placeholder="Your Phone *" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-eurogold-400 transition text-white" />
          <textarea name="message" required rows="3" placeholder="How can we help? (required) *" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-eurogold-400 transition text-white placeholder-white/40 resize-none"></textarea>
          <button type="submit" class="w-full bg-eurogold-400 text-black heading-font text-[10px] font-bold py-2.5 rounded-xl uppercase tracking-widest hover:bg-white transition">Submit</button>
        </form>
      </div>

    </div>

    <div class="mt-10 pt-6 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] uppercase tracking-widest text-white/20">
      <div>&copy; 2024 Eurocert Inspection Services Pvt. Ltd.</div>
      <div class="flex space-x-6">
        <a href="/privacy-policy" class="hover:text-white transition">Privacy Policy</a>
        <a href="/quality-policy" class="hover:text-white transition">Quality Policy</a>
        <a href="/grievance" class="hover:text-white transition">Grievance</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .footer-premium { color: #fff; background: #02070f; padding: 2rem 0 1rem; }
</style>

<script>
  document.getElementById('ec-callback-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = new FormData(form);
    const payload = {
      formType: 'contact',
      name: 'Callback Request',
      email: '',
      phone: data.get('phone'),
      service: 'Quick Callback',
      message: data.get('message'),
      source: 'Footer Callback'
    };
    const btn = form.querySelector('[type="submit"]');
    btn.disabled = true;
    try {
      await fetch('https://script.google.com/macros/s/AKfycbxDzomOX-pFvyGVQCgrNL2s24I9hPmZtzX61c0R9V51iNeA0JsorF2O-ZWNKEYSJ9gv/exec', {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload)
      });
      form.classList.add('hidden');
      form.closest('div').querySelector('#ec-callback-ok').classList.remove('hidden');
      setTimeout(() => {
        form.classList.remove('hidden');
        form.closest('div').querySelector('#ec-callback-ok').classList.add('hidden');
      }, 5000);
    } catch (err) {
      alert('Something went wrong. Please email info@eurocert.in instead.');
    } finally {
      btn.disabled = false;
    }
  });
</script>
</footer>