<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-[#030a16]"><div class="absolute inset-0 z-0"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782368074/eurocert/g4.png.png" class="absolute inset-0 w-full h-full object-cover" alt="Contact Eurocert certification experts for compliance support"/><div class="absolute inset-0 bg-[#030a16]/75"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(212,168,67,0.08)_0%,transparent_60%)]"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(19,62,124,0.15)_0%,transparent_50%)]"></div></div><div class="container mx-auto px-6 relative z-10 text-center py-24"><div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-eurogold-400/30 bg-eurogold-400/5 mb-5"><span class="w-1.5 h-1.5 rounded-full bg-eurogold-400 animate-pulse"></span><span class="heading-font text-[10px] text-eurogold-400 tracking-[0.3em] uppercase font-bold">Get In Touch</span></div><h1 class="heading-font text-4xl sm:text-6xl md:text-7xl font-bold text-white mb-3 tracking-tight" style="text-shadow:0 0 30px rgba(212,168,67,0.3)">Contact <span class="text-eurogold-400">Us</span></h1><div class="flex items-center justify-center gap-2 text-white/80 text-sm heading-font"><a class="hover:text-eurogold-400 transition-colors" href="/">Home</a><span>/</span><span class="text-white/70">Contact Us</span></div></div></section><section class="py-14 lg:py-18 bg-white" id="contact-form"><div class="container mx-auto px-6"><div class="max-w-5xl mx-auto"><div class="grid lg:grid-cols-5 gap-10 items-start"><div class="lg:col-span-2 space-y-6"><div><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-2 font-bold">Send a Message</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight">Get in <span class="text-euro-600">Touch</span></h2></div><p class="text-slate-400 text-sm leading-relaxed">Whether you are planning a new certification, our team is ready to support you.</p><div class="space-y-4 pt-2"><div class="flex items-start gap-4"><div class="w-10 h-10 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 shrink-0"><i class="fas fa-certificate text-sm"></i></div><div><h5 class="heading-font text-[10px] font-bold text-slate-900 uppercase tracking-widest">New Certification</h5><p class="text-slate-400 text-xs">Start your certification journey</p></div></div><div class="flex items-start gap-4"><div class="w-10 h-10 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 shrink-0"><i class="fas fa-clipboard-check text-sm"></i></div><div><h5 class="heading-font text-[10px] font-bold text-slate-900 uppercase tracking-widest">Audit Preparation</h5><p class="text-slate-400 text-xs">Get ready for upcoming audits</p></div></div><div class="flex items-start gap-4"><div class="w-10 h-10 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 shrink-0"><i class="fas fa-balance-scale text-sm"></i></div><div><h5 class="heading-font text-[10px] font-bold text-slate-900 uppercase tracking-widest">Regulatory Guidance</h5><p class="text-slate-400 text-xs">Navigate compliance requirements</p></div></div></div></div><div class="lg:col-span-3"><div class="bg-white border border-slate-100 shadow-[0_32px_80px_-15px_rgba(0,0,0,0.08)] rounded-3xl p-8 md:p-10"><form id="contactForm" class="space-y-5" onsubmit="return false;"><div id="formSuccess" class="hidden p-8 rounded-2xl bg-green-50 border border-green-200 text-center"><div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4"><i class="fas fa-check text-green-600 text-2xl"></i></div><h3 class="heading-font text-xl font-bold text-green-800 mb-2">Thank You for Contacting Eurocert!</h3><p class="text-green-600 text-sm">We have received your message and will respond within 24 hours.</p></div><div id="formFields"><div class="grid grid-cols-1 md:grid-cols-2 gap-5"><div><label class="block text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">Your Identity <span class="text-red-400">*</span></label><input type="text" name="name" required="" class="form-input" placeholder="Full Name" /></div><div><label class="block text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">Data Address <span class="text-red-400">*</span></label><input type="email" name="email" required="" class="form-input" placeholder="Email Address" /></div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-5"><div><label class="block text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">Mobile Node <span class="text-red-400">*</span></label><input type="tel" name="phone" required="" class="form-input" placeholder="Mobile Number" /></div><div><label class="block text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">Service Sector</label><select name="service" class="form-input appearance-none"><option value="" selected="">Select a Service</option><option value="CE Certification">CE Certification</option><option value="ISO Certifications">ISO Certifications</option><option value="FSSC 22000">FSSC 22000</option><option value="SA 8000">SA 8000</option><option value="Environmental Certifications">Environmental Certifications</option><option value="Social Audits">Social Audits</option><option value="Sustainability Certifications">Sustainability Certifications</option><option value="Food Safety Audits">Food Safety Audits</option><option value="Other">Other</option></select></div></div><div><label class="block text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">Transmission Message <span class="text-red-400">*</span></label><textarea name="message" rows="5" required="" class="form-input" placeholder="Detailed technical requirement..."></textarea></div><div class="p-4 rounded-xl bg-[#f8fafc] border border-slate-100"><label class="block text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3"><i class="fas fa-robot text-euro-600 mr-1"></i> Verify You Are Human</label><div class="flex items-center gap-4"><div class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-white border border-slate-200"><span id="captchaNum1" class="heading-font text-lg font-bold text-slate-700">1</span><span class="text-slate-400 font-bold">+</span><span id="captchaNum2" class="heading-font text-lg font-bold text-slate-700">1</span><span class="text-slate-400 font-bold">=</span></div><input type="number" name="captcha" required="" class="form-input !w-24 text-center" placeholder="?" /><button type="button" id="refreshCaptcha" class="w-9 h-9 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400 hover:text-euro-600 hover:bg-euro-50 transition-all" title="Refresh captcha"><i class="fas fa-sync-alt text-xs"></i></button></div></div><div id="formError" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-red-600 text-sm text-center"></div><button type="submit" id="submitBtn" class="w-full md:w-auto px-12 py-4 bg-euro-600 text-white heading-font text-xs font-bold rounded-2xl hover:bg-euro-700 transition shadow-2xl uppercase tracking-widest flex items-center justify-center gap-2"><i class="fas fa-paper-plane text-[10px]"></i> <span id="submitText">Send Message</span></button></div></form><script is:inline>(function(){var n1,n2;function gen(){n1=Math.floor(Math.random()*10)+1;n2=Math.floor(Math.random()*10)+1;document.getElementById('captchaNum1').textContent=n1;document.getElementById('captchaNum2').textContent=n2;document.querySelector('[name="captcha"]').value='';}gen();document.getElementById('refreshCaptcha').addEventListener('click',gen);document.getElementById('contactForm').addEventListener('submit',function(e){e.preventDefault();var err=document.getElementById('formError');var btn=document.getElementById('submitBtn');var txt=document.getElementById('submitText');err.classList.add('hidden');var ans=parseInt(document.querySelector('[name="captcha"]').value);if(isNaN(ans)){err.textContent='Please solve the captcha.';err.classList.remove('hidden');return;}if(ans!==n1+n2){err.textContent='Captcha answer is incorrect. '+n1+' + '+n2+' = '+(n1+n2);err.classList.remove('hidden');gen();return;}btn.disabled=true;txt.textContent='Sending...';var payload={formType:'contact',name:document.querySelector('[name="name"]').value,email:document.querySelector('[name="email"]').value,phone:document.querySelector('[name="phone"]').value,service:document.querySelector('[name="service"]').value,message:document.querySelector('[name="message"]').value,source:'Contact Us Page'};fetch('https://damnart-ai-guladab.n8n-wsk.com/webhook/eurocert-vanshita-landing',{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(payload)}).then(function(r){return r.text().then(function(t){return {ok:r.ok,status:r.status,text:t};});}).then(function(res){var t=(res.text||'')+'';var ok=res.ok||res.status===200||t.indexOf('success')>-1;if(ok){document.getElementById('contactForm').reset();gen();document.getElementById('formFields').classList.add('hidden');document.getElementById('formSuccess').classList.remove('hidden');}else{err.textContent='Submission failed. Please try again.';err.classList.remove('hidden');btn.disabled=false;txt.textContent='Send Message';gen();}}).catch(function(){err.textContent='Something went wrong. Please try again later.';err.classList.remove('hidden');btn.disabled=false;txt.textContent='Send Message';gen();});});})();</script></div></div></div></div></div></section><section class="relative overflow-hidden"><div class="absolute inset-0 bg-[#030a16]"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(212,168,67,0.05)_0%,transparent_60%)]"></div><div class="relative z-10 py-14 lg:py-18"><div class="container mx-auto px-6"><div class="max-w-5xl mx-auto"><div class="text-center mb-10"><h4 class="heading-font text-[11px] text-eurogold-400 tracking-[0.5em] uppercase mb-2 font-bold">Reach Us</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-white tracking-tight">Contact Eurocert Asia</h2><p class="text-white/40 text-sm mt-3 max-w-2xl mx-auto">We&#x27;re here to answer your questions about certification, inspection, and audits.</p></div><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5"><div class="p-6 rounded-2xl border border-white/5 bg-white/2 group hover:border-eurogold-400/20 transition-all duration-300"><div class="w-11 h-11 rounded-xl bg-eurogold-400/10 flex items-center justify-center mb-4 group-hover:bg-eurogold-400/20 transition-all"><i class="fas fa-map-marker-alt text-eurogold-400 text-base"></i></div><h4 class="heading-font text-[11px] font-bold text-white uppercase tracking-widest mb-2">Head Office</h4><p class="text-white/50 text-sm leading-relaxed">Eurocert Inspection Services</p><p class="text-white/45 text-sm leading-relaxed">Panchkula, Haryana, India</p></div><div class="p-6 rounded-2xl border border-white/5 bg-white/2 group hover:border-eurogold-400/20 transition-all duration-300"><div class="w-11 h-11 rounded-xl bg-eurogold-400/10 flex items-center justify-center mb-4 group-hover:bg-eurogold-400/20 transition-all"><i class="fas fa-phone-alt text-eurogold-400 text-base"></i></div><h4 class="heading-font text-[11px] font-bold text-white uppercase tracking-widest mb-2">Active Signal Lines</h4><a href="tel:+919316012883" class="text-white/50 text-sm leading-relaxed block hover:text-eurogold-400 transition-colors">+91 9316012883</a><a href="tel:+919262740889" class="text-white/50 text-sm leading-relaxed block hover:text-eurogold-400 transition-colors">+91 9262740889</a><span class="inline-flex items-center gap-1.5 mt-2"><span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span><span class="text-green-400/70 text-[10px] heading-font uppercase tracking-widest font-bold">Available Now</span></span></div><div class="p-6 rounded-2xl border border-white/5 bg-white/2 group hover:border-eurogold-400/20 transition-all duration-300"><div class="w-11 h-11 rounded-xl bg-eurogold-400/10 flex items-center justify-center mb-4 group-hover:bg-eurogold-400/20 transition-all"><i class="fas fa-envelope text-eurogold-400 text-base"></i></div><h4 class="heading-font text-[11px] font-bold text-white uppercase tracking-widest mb-2">Data Address</h4><a href="mailto:eurocert.mv@gmail.com" class="text-white/50 text-sm leading-relaxed block hover:text-eurogold-400 transition-colors">eurocert.mv@gmail.com</a><a href="mailto:info@eurocert.in" class="text-white/50 text-sm leading-relaxed block hover:text-eurogold-400 transition-colors">info@eurocert.in</a><p class="text-white/30 text-xs mt-2">Typically responds within 24 hours</p></div></div></div></div></div></section><section class="py-14 lg:py-18 bg-white"><div class="container mx-auto px-6"><div class="max-w-5xl mx-auto grid lg:grid-cols-5 gap-10 items-start"><div class="lg:col-span-3 space-y-6"><div><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-2 font-bold">Who We Are</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight">About <span class="text-euro-600">Eurocert Asia</span></h2></div><p class="text-slate-500 text-[15px] leading-relaxed">Eurocert Asia, a part of the prestigious Eurocert Group based in Athens, Greece, is a leading certification body located in Panchkula, Haryana, India. We specialize in providing essential certifications for businesses aiming to operate in the European market.</p><p class="text-slate-400 text-sm leading-relaxed">With a strong focus on compliance with international standards and fostering sustainable business practices, Eurocert Asia helps organizations enhance their credibility, meet regulatory requirements, and improve overall environmental and social performance.</p><p class="text-slate-400 text-sm leading-relaxed">Our expert team provides comprehensive guidance throughout the certification process, ensuring that businesses thrive in the global marketplace. At Eurocert Asia, we are dedicated to delivering high-quality service, integrity, and customer satisfaction � making us your trusted partner in achieving certification success.</p><div class="pt-2"><h5 class="heading-font text-[11px] font-bold text-slate-900 uppercase tracking-widest mb-4">Our Services Include</h5><div class="grid sm:grid-cols-2 gap-2"><div class="flex items-center gap-2.5 py-2"><svg class="w-4 h-4 text-euro-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293l-4 4a1 1 0 01-1.414 0l-2-2a1 1 0 111.414-1.414L9 10.586l3.293-3.293a1 1 0 111.414 1.414z"></path></svg><span class="text-slate-600 text-sm font-medium">CE Certification</span></div><div class="flex items-center gap-2.5 py-2"><svg class="w-4 h-4 text-euro-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293l-4 4a1 1 0 01-1.414 0l-2-2a1 1 0 111.414-1.414L9 10.586l3.293-3.293a1 1 0 111.414 1.414z"></path></svg><span class="text-slate-600 text-sm font-medium">ISO Certifications</span></div><div class="flex items-center gap-2.5 py-2"><svg class="w-4 h-4 text-euro-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293l-4 4a1 1 0 01-1.414 0l-2-2a1 1 0 111.414-1.414L9 10.586l3.293-3.293a1 1 0 111.414 1.414z"></path></svg><span class="text-slate-600 text-sm font-medium">FSSC 22000</span></div><div class="flex items-center gap-2.5 py-2"><svg class="w-4 h-4 text-euro-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293l-4 4a1 1 0 01-1.414 0l-2-2a1 1 0 111.414-1.414L9 10.586l3.293-3.293a1 1 0 111.414 1.414z"></path></svg><span class="text-slate-600 text-sm font-medium">SA 8000</span></div><div class="flex items-center gap-2.5 py-2"><svg class="w-4 h-4 text-euro-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293l-4 4a1 1 0 01-1.414 0l-2-2a1 1 0 111.414-1.414L9 10.586l3.293-3.293a1 1 0 111.414 1.414z"></path></svg><span class="text-slate-600 text-sm font-medium">Environmental Certifications</span></div><div class="flex items-center gap-2.5 py-2"><svg class="w-4 h-4 text-euro-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293l-4 4a1 1 0 01-1.414 0l-2-2a1 1 0 111.414-1.414L9 10.586l3.293-3.293a1 1 0 111.414 1.414z"></path></svg><span class="text-slate-600 text-sm font-medium">Social Audits</span></div><div class="flex items-center gap-2.5 py-2"><svg class="w-4 h-4 text-euro-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293l-4 4a1 1 0 01-1.414 0l-2-2a1 1 0 111.414-1.414L9 10.586l3.293-3.293a1 1 0 111.414 1.414z"></path></svg><span class="text-slate-600 text-sm font-medium">Sustainability Certifications</span></div></div></div></div><div class="lg:col-span-2 space-y-5"><div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] shadow-sm"><div class="flex items-center gap-3 mb-5"><div class="w-10 h-10 rounded-xl bg-euro-600 flex items-center justify-center"><i class="fas fa-building text-white text-sm"></i></div><h4 class="heading-font text-[11px] font-bold text-slate-900 uppercase tracking-widest">Office Address</h4></div><p class="text-slate-600 text-sm leading-relaxed font-medium">Eurocert Inspection Services Pvt. Ltd.</p><p class="text-slate-400 text-sm leading-relaxed mt-1">304, Mid Town Tower, Peer Muchalla,<br/>Panchkula, Haryana � 134109, India</p><div class="mt-5 pt-5 border-t border-slate-100 space-y-3"><a href="tel:+919316012883" class="flex items-center gap-3 text-sm text-slate-600 hover:text-euro-600 transition-colors"><i class="fas fa-phone text-euro-600 text-xs w-5 text-center"></i><span>+91 9316012883</span></a><a href="mailto:eurocert.mv@gmail.com" class="flex items-center gap-3 text-sm text-slate-600 hover:text-euro-600 transition-colors"><i class="fas fa-envelope text-euro-600 text-xs w-5 text-center"></i><span>eurocert.mv@gmail.com</span></a><a href="mailto:info@eurocert.in" class="flex items-center gap-3 text-sm text-slate-600 hover:text-euro-600 transition-colors"><i class="fas fa-envelope text-euro-600 text-xs w-5 text-center"></i><span>info@eurocert.in</span></a></div></div><div class="rounded-2xl overflow-hidden border border-slate-100 shadow-sm h-[320px]"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3432.0276612984553!2d76.85933983605888!3d30.66134957088047!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390fec4817954101%3A0x49f7c1af9c0f341!2sEUROCERT!5e0!3m2!1sen!2sin!4v1788321014228!5m2!1sen!2sin" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div></div></div></section>
