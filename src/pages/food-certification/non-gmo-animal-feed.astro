d" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg></div><h4 class="text-xl font-display font-bold text-gray-800 mb-4 uppercase">Training &amp; Personnel Programs</h4><p class="text-sm text-gray-500 font-sans leading-relaxed">Comprehensive training programs for personnel handling non-GMO feed to ensure awareness and compliance at every level.</p></div><div class="glass-panel p-8 sm:p-10 rounded-[2rem] group hover:bg-white/[0.08] hover:border-accent hover:shadow-[0_0_40px_rgba(91,141,239,0.3)] hover:-translate-y-2 transition-all duration-400"><div class="w-12 h-12 bg-accent/20 rounded-xl flex items-center justify-center mb-8 border border-accent/30 group-hover:scale-110 transition"><svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg></div><h4 class="text-xl font-display font-bold text-gray-800 mb-4 uppercase">Internal Audit &amp; Monitoring</h4><p class="text-sm text-gray-500 font-sans leading-relaxed">Establishment and verification of internal audit and monitoring procedures to maintain ongoing non-GMO compliance.</p></div></div></div></section><section class="py-16 md:py-24 relative z-10"><div class="container mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-12 lg:gap-20"><div class="space-y-12"><h3 class="text-3xl font-display font-black text-gray-800 uppercase tracking-widest border-l-4 border-accent pl-6">Benefits of Certification</h3><div class="space-y-6"><div class="flex gap-6 group"><svg class="w-6 h-6 text-accent drop-shadow-[0_0_5px_rgba(0,123,167,0.5)] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><p