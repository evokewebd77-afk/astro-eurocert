---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="FoSTaC Training - Food Safety Training & Certification | EUROCERT"
  description="FSSAI FoSTaC Training and Certification courses for food handlers, supervisors, and managers by EUROCERT."
>
  <style is:global>
    @font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}
.ft-form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  width: 100%;
}
@media (min-width: 720px) {
  .ft-form-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
}
.ft-form-grid > div {
  min-width: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
}
.ft-form select,
.ft-form input,
.ft-form textarea {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 12px 14px;
  margin: 0;
  font: inherit;
  font-size: 15px;
  line-height: 1.4;
  background: #fff;
  color: var(--ink, #0f172a);
}
.ft-form select { appearance: auto; }
.ft-form label.ft-lab {
  display: block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: #64748b;
  margin: 0 0 6px;
}
.ft-form .ft-span-2 { grid-column: 1 / -1; }
.ft-map-link { color: var(--orange); font-weight: 700; text-decoration: underline; }
.ft-batch-note {
  margin-top: 12px; padding: 12px 14px; border-radius: 8px;
  background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; font-size: 13.5px; line-height: 1.5;
}
.ft-batch-note a { color: #c2410c; font-weight: 700; text-decoration: underline; }


.ft-flyer-dl {
  margin-top: 20px; display: flex; flex-wrap: wrap; gap: 18px; align-items: center;
  padding: 20px 22px; border-radius: 12px; border: 1px solid #e5eaf0;
  background: #fff; box-shadow: 0 12px 32px rgba(15,23,42,.08);
}
.ft-flyer-dl-thumb {
  width: 96px; height: 128px; object-fit: cover; border-radius: 8px;
  border: 1px solid #e2e8f0; flex-shrink: 0;
}
.ft-flyer-dl-copy { flex: 1; min-width: 200px; }
.ft-flyer-dl-copy h3 { margin: 0 0 6px; font-size: 18px; color: var(--navy); }
.ft-flyer-dl-copy p { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.5; }
.ft-flyer-dl .ft-btn { margin-top: 0; }
.ft-venue-block {
  margin-top: 10px; padding: 12px 14px; border-radius: 8px;
  background: #f8fafc; border: 1px solid #e2e8f0; font-size: 13.5px; line-height: 1.55; color: #334155;
}
.ft-venue-card {
  grid-column: 1 / -1;
  order: 6;
  margin-top: 4px;
  background: #fff;
  border: 1px solid #e6ebf1;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 12px 32px rgba(15,23,42,.08);
}
.ft-venue-card-head {
  display: flex; align-items: center; gap: 12px;
  padding: 16px 20px;
  background: linear-gradient(90deg, #001a33 0%, #0b2a4a 100%);
  color: #fff;
}
.ft-venue-card-head .ico {
  width: 40px; height: 40px; border-radius: 10px;
  background: rgba(242,108,33,.2); color: #f26c21;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ft-venue-card-head h3 {
  margin: 0; font-size: 16px; font-weight: 800; letter-spacing: .02em;
}
.ft-venue-card-head p {
  margin: 2px 0 0; font-size: 12px; opacity: .75;
}
.ft-venue-card-body {
  display: grid;
  grid-template-columns: minmax(240px, 320px) 1fr;
  min-height: 300px;
}
.ft-venue-info {
  padding: 20px 18px;
  background: #f8fafc;
  border-right: 1px solid #eef2f7;
  display: flex; flex-direction: column; gap: 14px;
}
.ft-venue-info .line {
  display: flex; gap: 10px; align-items: flex-start;
  font-size: 14px; line-height: 1.5; color: #334155;
}
.ft-venue-info .line i {
  color: #f26c21; margin-top: 3px; width: 16px; text-align: center; flex-shrink: 0;
}
.ft-venue-info .line strong {
  display: block; font-size: 11px; letter-spacing: .06em;
  text-transform: uppercase; color: #64748b; margin-bottom: 2px;
}
.ft-venue-btns { display: flex; flex-direction: column; gap: 8px; margin-top: auto; }
.ft-venue-btns a {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 42px; padding: 10px 14px; border-radius: 8px;
  font-size: 13px; font-weight: 700; text-decoration: none;
}
.ft-venue-btns .go {
  background: #f26c21; color: #fff;
}
.ft-venue-btns .go:hover { background: #d95a14; }
.ft-venue-btns .open {
  background: #fff; color: #001a33; border: 1px solid #dbe3ee;
}
.ft-venue-btns .open:hover { border-color: #001a33; }
.ft-venue-map {
  min-height: 300px; background: #e2e8f0; position: relative;
}
.ft-venue-map iframe {
  position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block;
}
@media (max-width: 860px) {
  .ft-venue-card-body { grid-template-columns: 1fr; }
  .ft-venue-info { border-right: 0; border-bottom: 1px solid #eef2f7; }
  .ft-venue-map { min-height: 260px; }
  .ft-venue-map iframe { position: relative; min-height: 260px; }
}

/* FoSTaC page only — dedicated WhatsApp float */
.ft-float {
  position: fixed; right: 18px; bottom: 18px; z-index: 9999;
  display: flex; flex-direction: column; gap: 10px; align-items: flex-end;
}
.ft-float a {
  display: inline-flex; align-items: center; justify-content: center;
  width: 54px; height: 54px; border-radius: 50%;
  text-decoration: none; box-shadow: 0 10px 28px rgba(0,0,0,.28);
  transition: transform .2s ease, box-shadow .2s ease;
}
.ft-float a:hover { transform: translateY(-2px) scale(1.04); }
.ft-float .ft-wa {
  background: #25d366; color: #fff;
}
.ft-float .ft-wa i { font-size: 28px; color: #fff; }
.ft-float .ft-call {
  background: #001a33; color: #f26c21; border: 1.5px solid rgba(242,108,33,.55);
}
.ft-float .ft-call i { font-size: 18px; color: #f26c21; }
@media (max-width: 640px) {
  .ft-float { right: 14px; bottom: 14px; }
  .ft-float a { width: 50px; height: 50px; }
}





:root {
  --navy: #001a33;
  --navy-2: #0b2a4a;
  --orange: #f26c21;
  --orange-dark: #d95a14;
  --ink: #0f172a;
  --muted: #5b6b7c;
  --line: #e5eaf0;
  --wrap: min(1100px, calc(100% - 2rem));
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; color: var(--ink); background: #fff; overflow-x: hidden; }
a { color: inherit; text-decoration: none; }
img { max-width: 100%; height: auto; display: block; }
#fostac-main { overflow-x: hidden; }
.ft-wrap { width: var(--wrap); margin-inline: auto; }

/* ===== HERO ===== */
.ft-hero {
  position: relative; color: #fff; overflow: visible;
  background:
    linear-gradient(105deg, rgba(0,16,36,.93) 0%, rgba(0,18,40,.78) 40%, rgba(0,18,40,.35) 68%, rgba(0,18,40,.15) 100%),
    url('https://res.cloudinary.com/drm8wdb7m/image/upload/f_auto,q_auto,w_720/c_limit,f_auto,q_auto:good,dpr_auto,w_1920/v1783746280/ChatGPT_Image_Jul_11_2026_10_28_48_AM_gcmjyg.png') right center / cover no-repeat;
  padding: 56px 0 0;
}
.ft-hero-inner { position: relative; z-index: 2; }
.ft-hero-main {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) 200px;
  gap: 32px 40px;
  align-items: start;
  padding-bottom: 36px;
}
.ft-hero-copy { max-width: 36rem; }
.ft-tag {
  display: inline-block; background: var(--orange); color: #fff; font-size: 11px; font-weight: 800;
  letter-spacing: .08em; text-transform: uppercase; padding: 8px 14px; border-radius: 4px; margin-bottom: 16px;
}
.ft-hero h1 {
  margin: 0 0 10px; font-size: clamp(1.5rem, 2.2vw, 2.35rem); line-height: 1.18; font-weight: 800;
}
.ft-hero h2 {
  margin: 0 0 14px; color: var(--orange); font-size: clamp(1.35rem, 2vw, 2rem); font-weight: 800; line-height: 1.2;
}
.ft-hero .meta { margin: 0 0 6px; font-size: 15px; opacity: .95; }
.ft-hero .meta.org { color: var(--orange); font-weight: 700; }
.ft-hero .desc { margin: 14px 0 0; line-height: 1.65; opacity: .92; font-size: 15px; }
.ft-badge {
  width: 200px; background: #fff; color: #1a1a2e; border-radius: 10px; padding: 22px 16px;
  text-align: center; font-weight: 900; letter-spacing: .04em;
  box-shadow: 0 14px 36px rgba(0,0,0,.32); line-height: 1.15; margin-top: 4px;
}
.ft-badge .ft-logo-mark {
  font-size: 1.55rem; font-weight: 900; letter-spacing: .02em;
  background: linear-gradient(90deg, #5b2d8e 0%, #2e7d32 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.ft-badge small {
  display: block; margin-top: 8px; font-size: 10px; font-weight: 600; opacity: .62;
  line-height: 1.4; letter-spacing: .02em; color: #334155;
  -webkit-text-fill-color: #334155;
}
.ft-hero-panel {
  background: rgba(0, 16, 34, .94);
  border-radius: 14px 14px 0 0;
  padding: 22px 28px 0;
  box-shadow: 0 -10px 40px rgba(0,0,0,.25);
  backdrop-filter: blur(8px);
}
.ft-info {
  display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; padding: 0 0 8px;
}
.ft-info-item {
  display: flex; gap: 10px; align-items: flex-start;
  padding: 8px 16px; min-width: 0;
  border-right: 1px solid rgba(255,255,255,.14);
}
.ft-info-item:first-child { padding-left: 0; }
.ft-info-item:last-child { border-right: 0; padding-right: 0; }
.ft-info-item i { color: var(--orange); margin-top: 3px; width: 18px; text-align: center; flex-shrink: 0; font-size: 15px; }
.ft-info-item strong {
  display: block; font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
  opacity: .7; font-weight: 700; margin-bottom: 2px;
}
.ft-info-item span { font-size: 13.5px; font-weight: 700; line-height: 1.35; display: block; word-break: break-word; }
.ft-cta {
  display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;
  padding: 14px 0 0; transform: translateY(50%); margin-bottom: -22px;
}
.ft-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 46px; padding: 12px 28px; border-radius: 4px; font-weight: 800; font-size: 13px; letter-spacing: .05em;
  border: 0; cursor: pointer; text-transform: uppercase; white-space: nowrap;
  box-shadow: 0 8px 24px rgba(0,0,0,.2);
}
.ft-btn-orange { background: var(--orange); color: #fff; }
.ft-btn-orange:hover { background: var(--orange-dark); }
.ft-btn-navy { background: var(--navy); color: #fff; border: 1.5px solid rgba(255,255,255,.45); }
.ft-btn-navy:hover { background: var(--navy-2); }

@media (min-width: 1200px) {
  :root { --wrap: min(1120px, calc(100% - 4rem)); }
  .ft-hero {
    background:
      linear-gradient(100deg, rgba(0,16,36,.94) 0%, rgba(0,18,40,.75) 42%, rgba(0,18,40,.3) 70%, rgba(0,18,40,.1) 100%),
      url('https://res.cloudinary.com/drm8wdb7m/image/upload/f_auto,q_auto,w_720/c_limit,f_auto,q_auto:good,dpr_auto,w_1920/v1783746280/ChatGPT_Image_Jul_11_2026_10_28_48_AM_gcmjyg.png') 75% center / cover no-repeat;
    padding-top: 64px;
  }
  .ft-hero-main { padding-bottom: 40px; gap: 40px 56px; grid-template-columns: minmax(0, 1.4fr) 210px; }
  .ft-badge { width: 210px; }
  .ft-hero-panel { padding: 24px 32px 0; }
}
@media (min-width: 1600px) {
  :root { --wrap: min(1160px, calc(100% - 6rem)); }
  .ft-hero {
    background:
      linear-gradient(100deg, rgba(0,16,36,.95) 0%, rgba(0,18,40,.78) 40%, rgba(0,18,40,.28) 68%, rgba(0,18,40,.08) 100%),
      url('https://res.cloudinary.com/drm8wdb7m/image/upload/f_auto,q_auto,w_720/c_limit,f_auto,q_auto:good,dpr_auto,w_1920/v1783746280/ChatGPT_Image_Jul_11_2026_10_28_48_AM_gcmjyg.png') 70% center / cover no-repeat;
  }
}

.ft-sec { padding: clamp(40px, 6vw, 72px) 0; }
.ft-sec.navy { background: var(--navy); color: #fff; }
.ft-sec.soft { background: #f7f9fc; }
.ft-eyebrow {
  margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #1d4ed8;
}
.ft-sec.navy .ft-eyebrow { color: #fdba74; }
.ft-title { margin: 0 0 20px; font-size: clamp(1.35rem, 2.5vw, 2rem); color: var(--navy); font-weight: 800; }
.ft-sec.navy .ft-title { color: #fff; }
.ft-muted { color: var(--muted); line-height: 1.7; font-size: 15px; }
.ft-sec.navy .ft-muted { color: rgba(255,255,255,.8); }

/* ABOUT */
.ft-about {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  gap: clamp(24px, 4vw, 44px); align-items: start;
}
.ft-about p { margin: 0 0 14px; }
.ft-hcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.ft-hcard {
  background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 22px 14px 20px;
  text-align: center; box-shadow: 0 10px 28px rgba(15,23,42,.06); height: 100%;
}
.ft-hcard .ico {
  width: 52px; height: 52px; margin: 0 auto 14px; border-radius: 50%;
  background: #fff7ed; color: var(--orange); display: flex; align-items: center; justify-content: center; font-size: 22px;
}
.ft-hcard h3 { margin: 0 0 8px; font-size: 15px; color: var(--navy); }
.ft-hcard p { margin: 0; font-size: 13px; color: var(--muted); line-height: 1.5; }

/* TOPICS + CERT */
.ft-topics {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(240px, 1.05fr) minmax(0, .85fr);
  gap: 28px; align-items: center;
}
.ft-topics .ft-eyebrow { color: var(--orange) !important; margin-bottom: 10px; }
.ft-topics .ft-title { margin: 0 0 8px; color: #fff; font-size: clamp(1.35rem, 2.3vw, 1.85rem); }
.ft-rule { display: block; width: 42px; height: 3px; border-radius: 2px; margin: 0 0 20px; }
.ft-rule.orange { background: var(--orange); }
.ft-rule.grey { background: rgba(255,255,255,.35); }
.ft-topic-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 22px; margin: 0; }
.ft-topic-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.ft-topic-grid li {
  display: flex; gap: 10px; align-items: flex-start;
  color: #fff; font-size: 14.5px; line-height: 1.45;
}
.ft-cert-img {
  margin: 0; background: #fff; border-radius: 6px; overflow: hidden;
  box-shadow: 0 16px 40px rgba(0,0,0,.35);
  width: 100%; max-width: 520px; justify-self: center;
}
.ft-cert-img img {
  width: 100%; height: auto; display: block;
}
.ft-cert-copy .ft-title { margin-bottom: 8px; }
.ft-cert-copy p {
  margin: 0; color: rgba(255,255,255,.88); font-size: 14.5px; line-height: 1.65; max-width: 28rem;
}

.ft-check {
  width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0; margin-top: 1px;
  display: inline-flex; align-items: center; justify-content: center;
  color: #fff; font-size: 11px;
}
.ft-check.orange { background: var(--orange); }
.ft-check.navy { background: var(--navy); }

/* HIGHLIGHTS */
.ft-highlights {
  display: grid; grid-template-columns: 1.15fr .95fr; gap: 0; align-items: start;
}
.ft-hl-col { padding: 8px 36px 8px 0; }
.ft-hl-col + .ft-hl-col { padding: 8px 0 8px 36px; border-left: 1px solid #dbe3ec; }
.ft-hl-col .ft-eyebrow { color: #2563eb; margin-bottom: 10px; }
.ft-hl-col .ft-title { margin: 0 0 22px; color: var(--navy); font-size: clamp(1.35rem, 2.3vw, 1.85rem); }
.ft-hl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; margin: 0; }
.ft-hl-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
.ft-why-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
.ft-hl-grid li, .ft-why-list li {
  display: flex; gap: 10px; align-items: flex-start;
  font-size: 14.5px; line-height: 1.45; color: #1e293b;
}

/* AUDIENCE */
.ft-audience { display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: start; }
.ft-audience-col { padding: 8px 36px 8px 0; }
.ft-audience-col + .ft-audience-col {
  padding: 8px 0 8px 36px; border-left: 1px solid rgba(255,255,255,.18);
}
.ft-audience .ft-eyebrow { color: var(--orange) !important; margin-bottom: 10px; }
.ft-audience .ft-title { margin: 0 0 10px; color: #fff; font-size: clamp(1.35rem, 2.4vw, 1.9rem); }
.ft-audience .lead { margin: 0 0 18px; color: rgba(255,255,255,.88); font-size: 14.5px; }
.ft-aud-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 28px; margin: 0 0 20px; }
.ft-aud-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.ft-aud-grid li, .ft-out-list li {
  display: flex; gap: 10px; align-items: flex-start;
  color: #fff; font-size: 14.5px; line-height: 1.45;
}
.ft-aud-grid li::before {
  content: ""; width: 7px; height: 7px; margin-top: 6px; flex-shrink: 0;
  background: var(--orange); border-radius: 1px;
}
.ft-out-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.ft-out-list li::before {
  content: ""; width: 7px; height: 7px; margin-top: 6px; flex-shrink: 0;
  background: var(--orange); transform: rotate(45deg);
}
.ft-grad {
  display: flex; gap: 14px; align-items: flex-start;
  margin-top: 6px; border-radius: 10px; padding: 14px 16px;
  border: 1px solid rgba(147, 197, 253, .55); background: transparent; color: #fff;
}
.ft-grad .ico {
  width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
  background: var(--orange); color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.ft-grad strong { display: block; color: #fff; margin-bottom: 4px; font-size: 14.5px; }
.ft-grad span { font-size: 13.5px; color: rgba(255,255,255,.88); line-height: 1.5; }

/* REGISTER */
.ft-sec.register { background: #fff; }
.ft-reg-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 18px; align-items: start;
}
.ft-reg-intro .ft-title { margin-bottom: 12px; }
.ft-reg-intro .ft-muted { margin: 0 0 12px; font-size: 14px; }
.ft-contact-box {
  margin-top: 18px; background: #f3f5f8; border-radius: 10px; padding: 14px 16px;
  display: grid; gap: 10px;
}
.ft-contact-box a {
  display: flex; gap: 10px; align-items: center; font-size: 13.5px; color: var(--ink); font-weight: 600;
  word-break: break-word;
}
.ft-contact-box i { color: #2563eb; width: 16px; text-align: center; flex-shrink: 0; }
.ft-card {
  background: #fff; border: 1px solid #e6ebf1; border-radius: 12px; padding: 20px 18px;
  box-shadow: 0 8px 24px rgba(15,23,42,.04); height: 100%;
}
.ft-card h4 {
  margin: 0 0 14px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
  color: #2563eb; font-weight: 800;
}
.ft-detail-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.ft-detail-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; line-height: 1.4; color: #334155; }
.ft-detail-list i { color: #2563eb; margin-top: 2px; width: 16px; text-align: center; flex-shrink: 0; }
.ft-detail-list strong { color: var(--navy); font-weight: 700; }
.ft-include-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.ft-include-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; line-height: 1.45; color: #334155; }
