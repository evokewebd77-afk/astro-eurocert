<script>
(function(){
  function ready(fn){ if(document.readyState!=='loading') fn(); else document.addEventListener('DOMContentLoaded', fn); }
  ready(function(){
    var menu = document.getElementById('ec-mobile-menu');
    var openBtn = document.getElementById('ec-mobile-open');
    var closeBtn = document.getElementById('ec-mobile-close');
    if(!menu || !openBtn) return;
    var isOpen = false;
    function show(){
      isOpen = true;
      menu.style.display = 'flex';
      openBtn.setAttribute('aria-expanded', 'true');
    }
    function hide(){
      isOpen = false;
      menu.style.display = 'none';
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }
    function toggle(e){
      if(e){ e.preventDefault(); e.stopPropagation(); }
      if(isOpen) hide(); else show();
    }
    openBtn.addEventListener('click', toggle);
    if(closeBtn) closeBtn.addEventListener('click', function(e){ e.preventDefault(); hide(); });
    document.addEventListener('keydown', function(e){ if(e.key==='Escape' && isOpen) hide(); });
    var links = menu.querySelectorAll('a');
    for(var i=0;i<links.length;i++){
      links[i].addEventListener('click', function(){ hide(); });
    }
  });
})();
</script>

