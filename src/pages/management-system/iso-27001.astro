---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ISO/IEC 27001 Certification | EUROCERT"
  description="EUROCERT ISO/IEC 27001 certification \u2014 independent information security management system audits, Stage 1 & Stage 2, surveillance and recertification."
  canonicalUrl="https://www.eurocert.asia/management-system/iso-27001/"
  ogImage="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png"
  keywords="Eurocert,Eurocert Asia,ISO certification,CE marking"
>
<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<style is:global>:root {
  --navy: #04122a;
  --navy-2: #0a1f3d;
  --gold: #d4a843;
  --gold-2: #e6c05a;
  --ink: #0f172a;
  --muted: #64748b;
  --line: #e2e8f0;
  --wrap: min(1140px, calc(100% - 32px));
  --blue: #1d4ed8;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; max-width: 100%; }
body { margin: 0; color: var(--ink); background: #fff; font-family: Inter, system-ui, sans-serif; overflow-x: hidden; max-width: 100%; }
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; }
.is-wrap { width: var(--wrap); margin-inline: auto; max-width: 100%; }
#iso27001-main { overflow-x: hidden; max-width: 100%; }
#site-header { max-width: 100%; overflow-x: clip; }
#site-header a { text-decoration: none; }
#site-header .container { width: 100%; max-width: 80rem; margin-inline: auto; padding-inline: 1rem; }
#site-header .logo-img { max-height: 56px; width: auto; }
.is-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 14px 22px; border-radius: 6px; font-weight: 800; font-size: 13px;
  letter-spacing: .04em; text-transform: uppercase; text-decoration: none; border: 0; cursor: pointer;
  max-width: 100%;
}
.is-btn-gold { background: var(--gold); color: #04122a; }
.is-btn-gold:hover { background: var(--gold-2); }
.is-btn-outline { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.85); }
.is-btn-outline:hover { background: rgba(255,255,255,.08); }
.is-btn-outline-dark { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.55); }




.is-hero {
  position: relative; color: #fff; overflow: hidden;
  background: #030a18;
  padding: clamp(56px, 8vw, 100px) 0 clamp(48px, 6vw, 80px);
  min-height: clamp(520px, 68vh, 680px);
  display: flex;
  align-items: center;
}
.is-hero::before {
  content: "";
  position: absolute; inset: 0;
  background:
    linear-gradient(90deg,
      #030a18 0%,
      rgba(3,10,24,.95) 18%,
      rgba(3,10,24,.7) 32%,
      rgba(3,10,24,.25) 48%,
      rgba(3,10,24,.05) 62%,
      transparent 78%),
    url('https://res.cloudinary.com/drm8wdb7m/image/upload/f_auto,q_auto:good,w_1600/v1784347184/ChatGPT_Image_Jul_18_2026_09_28_08_AM_l4ayib.png') right center / cover no-repeat;
  z-index: 0;
}
.is-hero .is-wrap {
  width: min(1180px, calc(100% - 40px));
  position: relative;
  z-index: 1;
}
.is-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  gap: clamp(16px, 3vw, 36px);
  align-items: center;
  width: 100%;
}
.is-hero-copy {
  max-width: 33rem;
  min-width: 0;
  position: relative;
  z-index: 2;
}
.is-eyebrow {
  display: inline-block; color: var(--gold); font-size: clamp(10px, 1.3vw, 11px); font-weight: 800;
  letter-spacing: .14em; text-transform: uppercase; margin: 0 0 16px;
}
.is-hero h1 {
  margin: 0 0 14px; font-size: clamp(2rem, 3.8vw, 3.35rem); line-height: 1.05; font-weight: 800;
}
.is-hero h2 {
  margin: 0 0 18px; color: var(--gold); font-size: clamp(1.05rem, 1.9vw, 1.45rem); font-weight: 700; line-height: 1.35;
}
.is-hero .is-hero-text {
  margin: 0 0 12px; max-width: 32rem; line-height: 1.7; opacity: .93;
  font-size: clamp(13.5px, 1.15vw, 15px);
}
.is-hero .is-hero-text:last-of-type { margin-bottom: 26px; }
.is-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.is-hero-visual {
  min-width: 0;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  position: relative;
  z-index: 1;
}
.is-hero-visual img {
  width: min(100%, 540px);
  height: auto;
  max-height: 460px;
  object-fit: contain;
  object-position: right center;
  /* Avoid double-shield with banner bg: hide decorative duplicate on large screens */
  opacity: 0;
  pointer-events: none;
}

.is-trust {
  background: #fff;
  border-bottom: 1px solid #eef2f7;
  padding: 26px 0;
}
.is-trust-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px 28px; }
.is-trust-item {
  display: flex; gap: 12px; align-items: center; min-width: 0;
  font-size: 13.5px; font-weight: 700; color: #0f172a; line-height: 1.35;
}
.is-trust-item i {
  width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
  background: #eef4ff; color: #2563eb; font-size: 15px;
}

.is-sec { padding: 72px 0; }
.is-sec.alt { background: #f8fafc; }
.is-title { margin: 0 0 14px; font-size: clamp(1.4rem, 2.5vw, 2.15rem); font-weight: 800; line-height: 1.2; color: var(--navy); }
.is-lead { margin: 0 0 18px; color: var(--muted); line-height: 1.7; font-size: 15.5px; max-width: 38rem; }

.is-why { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.35fr); gap: 48px; align-items: start; }
.is-why .is-title { margin-bottom: 18px; }
.is-why .is-lead { max-width: none; margin-bottom: 16px; color: #475569; font-size: 15px; }

.is-overview {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
  gap: 40px 48px;
  align-items: start;
}
.is-overview .eyebrow {
  margin: 0 0 8px; font-size: 11px; font-weight: 800; letter-spacing: .2em;
  text-transform: uppercase; color: #1d4ed8;
}
.is-overview .is-title { margin-bottom: 16px; }
.is-overview .is-lead { max-width: none; margin-bottom: 14px; color: #64748b; font-size: 15px; }
.is-overview-art {
  width: 100%; border-radius: 16px; overflow: hidden;
  border: 1px solid #e8eef5; background: #f8fafc;
  box-shadow: 0 16px 40px rgba(15,23,42,.08);
}
.is-overview-art img {
  display: block; width: 100%; height: auto;
}
.is-benefit-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.is-benefit {
  display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px 14px; align-items: start;
  background: #fff; border: 1px solid #e8eef5; border-radius: 14px; padding: 18px 16px;
  box-shadow: 0 6px 18px rgba(15,23,42,.04); min-width: 0;
}
.is-benefit i {
  width: 40px; height: 40px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center;
  background: #eef4ff; color: #2563eb; font-size: 17px; grid-row: 1 / span 2;
}
.is-benefit h3 { margin: 0; font-size: 15px; font-weight: 800; color: var(--navy); line-height: 1.3; }
.is-benefit p { margin: 0; font-size: 13.5px; color: #64748b; line-height: 1.55; }

.is-services { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
.is-svc {
  background: #fff; border: 1px solid #e8eef5; border-radius: 14px; padding: 22px 18px;
  display: flex; flex-direction: column; gap: 10px; min-height: 100%; min-width: 0;
  box-shadow: 0 8px 24px rgba(15,23,42,.05);
}
.is-svc i {
  width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center;
  background: #eef4ff; color: #2563eb; font-size: 18px;
}
.is-svc h3 { margin: 0; font-size: 15px; font-weight: 800; color: var(--navy); }
.is-svc p { margin: 0; font-size: 13.5px; color: #64748b; line-height: 1.55; flex: 1; }
.is-svc a { color: var(--gold); font-weight: 800; font-size: 13px; text-decoration: none; margin-top: 4px; }
.is-svc a:hover { text-decoration: underline; }

.is-vs {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; align-items: stretch;
  position: relative; margin-top: 40px;
}
.is-stage { border-radius: 16px; padding: 28px 26px 24px; min-width: 0; border: 1px solid transparent; }
.is-stage.s1 { grid-column: 1; background: #eef5ff; border-color: #dbeafe; border-radius: 16px 0 0 16px; padding-right: 36px; }
.is-stage.s2 { grid-column: 2; background: #fff8eb; border-color: #fdecc8; border-radius: 0 16px 16px 0; padding-left: 36px; }
.is-stage h3 { margin: 0 0 6px; font-size: 1.35rem; font-weight: 800; color: #0b3a7a; }
.is-stage.s2 h3 { color: #b45309; }
.is-stage .tag { margin: 0 0 18px; font-size: 14px; font-weight: 600; color: #3b82f6; }
.is-stage.s2 .tag { color: #d97706; }
.is-stage ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 11px; }
.is-stage li { display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px; line-height: 1.45; color: #1e293b; }
.is-stage li i { color: #2563eb; margin-top: 3px; flex-shrink: 0; font-size: 13px; }
.is-stage.s2 li i { color: #d97706; }
.is-stage .out {
  margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(15,23,42,.08);
  display: flex; gap: 12px; align-items: flex-start;
  font-size: 13.5px; line-height: 1.5; color: #334155;
}
.is-stage .out .ico {
  width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
  background: #2563eb; color: #fff; font-size: 14px;
}
.is-stage.s2 .out .ico { background: #d97706; }
.is-vs-badge {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  z-index: 2; width: 54px; height: 54px; border-radius: 50%;
  background: #0b1f3a; color: #fff; display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 14px; letter-spacing: .04em;
  box-shadow: 0 10px 28px rgba(4,18,42,.28); border: 3px solid #fff;
}

.is-process {
  display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: 10px 6px;
  position: relative;
}
.is-step {
  text-align: center; padding-top: 8px; min-width: 0; position: relative; z-index: 1;
}
.is-step .num {
  width: 52px; height: 52px; border-radius: 50%; margin: 0 auto 12px;
  background: #0b2a4a; color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 18px; position: relative; z-index: 2;
  box-shadow: 0 0 0 6px #fff;
}
.is-step:not(:last-child)::after {
  content: "";
  position: absolute; top: 33px; left: calc(50% + 30px); right: calc(-50% + 22px);
  border-top: 2px dashed #c5d0de; z-index: 0; pointer-events: none;
}
.is-step p { margin: 0; font-size: 12.5px; font-weight: 700; color: #1e293b; line-height: 1.35; }

.is-split { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 48px; align-items: start; }
.is-orgs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px 12px; }
.is-org {
  background: transparent; border: 0; border-radius: 0; padding: 4px 6px;
  text-align: center; font-size: 12.5px; font-weight: 700; color: #1e3a5f; line-height: 1.35; min-width: 0;
}
.is-org i { display: block; color: #1d4ed8; font-size: 22px; margin-bottom: 8px; }
.is-why-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
.is-why-list li {
  display: flex; gap: 14px; align-items: flex-start; background: transparent;
  border: 0; border-radius: 0; padding: 0;
  font-size: 14.5px; font-weight: 400; color: #1e293b; line-height: 1.45; min-width: 0;
}
.is-why-list li i {
  width: 28px; height: 28px; border-radius: 50%; background: #0b2a4a; color: #fff;
  display: inline-flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0; margin-top: 2px;
}
.is-why-list li strong { display: block; font-size: 15px; font-weight: 800; color: var(--navy); margin-bottom: 2px; }
.is-why-list li span { display: block; font-size: 13.5px; color: #64748b; line-height: 1.5; }

.is-impartial {
  background: #010b20;
  color: #fff;
  padding: 28px 0;
  overflow: hidden;
  width: 100%;
}
.is-impartial > .is-wrap {
  width: min(1320px, calc(100% - 40px));
}
.is-duo {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 0;
  align-items: center;
  min-height: 0;
}
.is-card-dark {
  position: relative;
  overflow: visible;
  padding: 0;
  min-width: 0;
  background: transparent;
  border-radius: 0;
  min-height: 0;
}
.is-card-dark.s-left {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr);
  gap: 14px;
  align-items: center;
  padding-right: 32px;
}
.is-card-dark.s-left .shield-ico {
  width: 34px; height: 34px; margin-top: 0;
  color: #fff; font-size: 28px; line-height: 1;
  display: flex; align-items: center; justify-content: center;
}
.is-card-dark.s-right {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 150px;
  gap: 12px 18px;
  align-items: center;
  border-left: 1px solid rgba(255,255,255,.2);
  padding: 0 0 0 32px;
  min-height: 0;
  overflow: visible;
}
.is-card-dark h3 {
  margin: 0 0 6px; font-size: clamp(1rem, 1.5vw, 1.2rem); font-weight: 800;
  color: #fff; position: relative; z-index: 2; line-height: 1.2;
}
.is-card-dark p {
  margin: 0; color: rgba(226,232,240,.88); line-height: 1.45;
  font-size: 12.5px; position: relative; z-index: 2; max-width: none;
}
.is-card-dark .is-cost-copy { position: relative; z-index: 2; max-width: none; }
.is-card-dark .is-cost-copy .is-btn {
  display: inline-flex; margin-top: 10px; position: relative; z-index: 2;
  text-transform: uppercase; letter-spacing: .04em; font-size: 11px;
  padding: 10px 14px; border-radius: 3px;
  background: #dda62c; color: #0a1628; font-weight: 800;
  box-shadow: none;
}
.is-card-dark .is-cost-copy .is-btn:hover { background: #e8b53a; }
.is-card-dark .art {
  position: relative;
  right: auto;
  top: auto;
  transform: none;
  width: 150px;
  max-width: 100%;
  height: 110px;
  display: block;
  margin: 0;
  object-fit: contain;
  object-position: center right;
  pointer-events: none;
  z-index: 1;
  mix-blend-mode: screen;
  filter: drop-shadow(0 0 18px rgba(0, 200, 255, .3));
  justify-self: end;
  align-self: center;
}

.is-faq-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px 20px;
  align-items: start;
}
.is-faq {
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
  min-width: 0;
  box-shadow: 0 1px 2px rgba(15,23,42,.03);
}
.is-faq summary {
  list-style: none; cursor: pointer; padding: 16px 18px; font-weight: 700; font-size: 14.5px; color: var(--navy);
  display: flex; justify-content: space-between; gap: 12px; align-items: center;
}
.is-faq summary::-webkit-details-marker { display: none; }
.is-faq summary i { color: #94a3b8; transition: transform .2s; flex-shrink: 0; font-size: 12px; }
.is-faq[open] summary i { transform: rotate(180deg); }
.is-faq .ans { padding: 0 18px 16px; color: var(--muted); font-size: 14px; line-height: 1.6; }

.is-cta {
  position: relative; overflow: hidden; color: #fff;
  background:
    linear-gradient(95deg, rgba(1,10,28,.35) 0%, rgba(1,10,28,.55) 28%, rgba(1,10,28,.82) 58%, rgba(1,10,28,.92) 100%),
    url('https://res.cloudinary.com/drm8wdb7m/image/upload/f_auto,q_auto:good,w_1600/v1784347183/ChatGPT_Image_Jul_14_2026_04_43_37_PM_eh4syo.png') left center / auto 175% no-repeat,
    #010b1c;
  padding: 40px 0;
  width: 100%;
}
.is-cta > .is-wrap {
  width: min(1440px, calc(100% - 32px));
  position: relative;
  z-index: 1;
}
.is-cta-grid {
  display: grid;
  grid-template-columns: minmax(0, 2.4fr) minmax(240px, 1fr);
  gap: 28px 40px;
  align-items: center;
  width: 100%;
  padding-left: min(18%, 220px);
}
.is-cta-visual { display: none; }
.is-cta-copy { min-width: 0; }
.is-cta h2 {
  margin: 0 0 8px; font-size: clamp(1.2rem, 2.1vw, 1.65rem); font-weight: 800; line-height: 1.25;
}
.is-cta p {
  margin: 0 0 14px; opacity: .88; line-height: 1.55; max-width: none; font-size: 14px;
}
.is-cta-actions { display: flex; flex-wrap: nowrap; gap: 10px; }
.is-cta-actions .is-btn {
  text-transform: uppercase; letter-spacing: .03em; font-size: 11px;
  padding: 11px 16px; white-space: nowrap;
}
.is-contact-box {
  background: transparent; border: 0;
  border-left: 1px solid rgba(255,255,255,.22);
  border-radius: 0; padding: 4px 0 4px 28px; min-width: 0;
  display: grid; gap: 14px;
  align-content: center;
}
.is-contact-box h3 { display: none; }
.is-contact-box a {
  display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 10px; align-items: center;
  color: #fff; text-decoration: none; padding: 0; font-size: 13px; word-break: break-word;
}
.is-contact-box a:hover { color: var(--gold); }
.is-contact-box .ci {
  width: 34px; height: 34px; border-radius: 50%;
  background: #fff; color: #0b2a4a;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 12px; flex-shrink: 0;
}
.is-contact-box .clabel { display: block; font-size: 11px; opacity: .72; margin-bottom: 1px; }
.is-contact-box .cval { display: block; font-weight: 700; font-size: 13.5px; line-height: 1.25; }

.is-related { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.is-rel {
  border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: #fff;
  text-decoration: none; color: inherit; min-width: 0;
}
.is-rel:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(15,23,42,.1); }
.is-rel img { width: 100%; height: 150px; object-fit: cover; }
.is-rel .body { padding: 16px 16px 18px; }
.is-rel h3 { margin: 0 0 6px; font-size: 16px; font-weight: 800; color: var(--navy); }
.is-rel p { margin: 0; font-size: 13.5px; color: var(--muted); line-height: 1.5; }

@media (min-width: 1400px) {
  .is-hero .is-wrap { width: min(1280px, calc(100% - 64px)); }
  .is-hero { min-height: 640px; }
  .is-hero-copy { max-width: 34rem; }
}
@media (max-width: 1100px) {
  .is-services { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .is-process { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .is-step:not(:last-child)::after { display: none; }
}
@media (max-width: 1024px) {
  .is-why, .is-split, .is-duo, .is-overview { grid-template-columns: 1fr; }
  .is-cta-grid {
    grid-template-columns: minmax(0, 1.6fr) minmax(200px, 1fr);
    gap: 18px 24px;
    padding-left: min(12%, 120px);
  }
  .is-cta-actions { flex-wrap: wrap; }
  .is-contact-box { padding-left: 18px; gap: 12px; }
  .is-card-dark.s-left { padding-right: 0; align-items: start; }
  .is-card-dark.s-right {
    grid-template-columns: minmax(0, 1fr) 130px;
    border-left: 0; border-top: 1px solid rgba(255,255,255,.18);
    padding: 20px 0 0; margin-top: 16px;
  }
  .is-card-dark .art { width: 130px; height: 96px; }
  .is-impartial { padding: 24px 0; }
  .is-impartial > .is-wrap { width: min(1140px, calc(100% - 28px)); }
  .is-trust-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
