---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="EUROCERT | ISO 28000"
  description="ISO 28000 certification for supply chain security management - reduce security risks, threats and disruption across your entire supply chain."
  canonicalUrl="https://www.eurocert.asia/management-system/iso-28000/"
  ogImage="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png"
  keywords="Eurocert,Eurocert Asia,ISO certification,CE marking,food safety certification,FSSC 22000,BRCGS,GFSI,social audits,Sedex,SMETA,SA8000,inspection services,certification body,India,management systems,ISO 9001,ISO 14001,ISO 45001"
>
<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<section class="relative min-h-[55vh] flex items-center justify-center overflow-hidden bg-[#030a16]"><div class="absolute inset-0 z-0"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367892/eurocert/b10.png.png" class="w-full h-full object-cover opacity-30" alt="ISO 28000 Supply Chain Security"/><div class="absolute inset-0 bg-gradient-to-b from-[#030a16]/70 via-[#030a16]/40 to-[#030a16]"></div></div><div class="container mx-auto px-6 relative z-10 text-center py-20"><div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-eurogold-400/30 bg-eurogold-400/5 mb-6"><span class="w-1.5 h-1.5 rounded-full bg-eurogold-400 animate-pulse"></span><span class="heading-font text-[10px] text-eurogold-400 tracking-[0.3em] uppercase font-bold">Safety in the Supply Chain</span></div><h1 class="heading-font text-4xl sm:text-6xl md:text-7xl font-bold text-white mb-3 tracking-tight" style="text-shadow:0 0 30px rgba(212,168,67,0.3)">ISO 28000 — Supply Chain Security</h1><p class="text-white/90 text-sm md:text-base max-w-xl mx-auto leading-relaxed">Security management systems for supply chain operations.</p></div></section><section class="py-14 lg:py-18 bg-white"><div class="container mx-auto px-6"><div class="grid lg:grid-cols-5 gap-10 items-start"><div class="lg:col-span-3 space-y-6"><div><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-2 font-bold">Standard Overview</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight">ISO 28000 — <span class="text-euro-600">Supply Chain Security</span></h2></div><p class="text-slate-500 text-[15px] leading-relaxed">We provide comprehensive ISO 28000 certification and compliance services to help your organization manage security risks in your supply chain.</p><div class="p-6 rounded-2xl border border-euro-100 bg-euro-50/40"><div class="flex items-center gap-3 mb-3"><div class="w-9 h-9 rounded-xl bg-euro-600 flex items-center justify-center"><i class="fas fa-info-circle text-white text-xs"></i></div><h4 class="heading-font text-[11px] text-euro-600 font-bold uppercase tracking-widest">What is ISO 28000?</h4></div><p class="text-slate-500 text-sm leading-relaxed">ISO 28000 specifies requirements for a security management system, including those aspects critical to security assurance of the supply chain. It helps organizations manage security risks in their supply chains and protect their operations from security threats.</p></div></div><div class="lg:col-span-2 relative rounded-2xl overflow-hidden shadow-xl border border-slate-100 h-[320px] md:h-[400px] group"><img src="https://res.cloudinary.com/didtfhfme/image/upload/f_auto,q_auto:good,w_1600/v1784005211/iso28_mqzvei.png" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" alt="ISO 28000 Supply Chain Security"/><div class="absolute inset-0 bg-gradient-to-t from-slate-900/20 via-transparent to-transparent"></div></div></div></div></section><section class="py-14 lg:py-18 bg-[#f8fafc]"><div class="container mx-auto px-6"><div class="text-center mb-10"><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-2 font-bold">Our Services</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">ISO 28000 <span class="text-euro-600">Services</span></h2></div><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto"><div class="p-6 bg-white rounded-2xl border border-slate-100 hover:border-euro-200 hover:shadow-lg transition-all duration-300 group"><div class="w-11 h-11 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 mb-4 group-hover:bg-euro-600 group-hover:text-white transition-all duration-300"><i class="fas fa-shield-alt text-base"></i></div><h4 class="heading-font text-[11px] font-bold uppercase tracking-widest text-slate-900 mb-2">ISO 28000 Certification</h4><p class="text-slate-400 text-sm leading-relaxed">Complete ISO 28000 certification services covering all requirements for establishing, implementing, and maintaining a security management system for your supply chain operations.</p></div><div class="p-6 bg-white rounded-2xl border border-slate-100 hover:border-euro-200 hover:shadow-lg transition-all duration-300 group"><div class="w-11 h-11 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 mb-4 group-hover:bg-euro-600 group-hover:text-white transition-all duration-300"><i class="fas fa-link text-base"></i></div><h4 class="heading-font text-[11px] font-bold uppercase tracking-widest text-slate-900 mb-2">Supply Chain Security Management</h4><p class="text-slate-400 text-sm leading-relaxed">Comprehensive supply chain security management solutions including threat assessment, vulnerability analysis, and implementation of robust security controls across your operations.</p></div><div class="p-6 bg-white rounded-2xl border border-slate-100 hover:border-euro-200 hover:shadow-lg transition-all duration-300 group"><div class="w-11 h-11 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 mb-4 group-hover:bg-euro-600 group-hover:text-white transition-all duration-300"><i class="fas fa-search text-base"></i></div><h4 class="heading-font text-[11px] font-bold uppercase tracking-widest text-slate-900 mb-2">Risk Assessment &amp; Mitigation</h4><p class="text-slate-400 text-sm leading-relaxed">Systematic identification, analysis, and evaluation of security risks across your supply chain, with tailored mitigation strategies to reduce exposure to threats and vulnerabilities.</p></div><div class="p-6 bg-white rounded-2xl border border-slate-100 hover:border-euro-200 hover:shadow-lg transition-all duration-300 group"><div class="w-11 h-11 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 mb-4 group-hover:bg-euro-600 group-hover:text-white transition-all duration-300"><i class="fas fa-cogs text-base"></i></div><h4 class="heading-font text-[11px] font-bold uppercase tracking-widest text-slate-900 mb-2">Security System Implementation</h4><p class="text-slate-400 text-sm leading-relaxed">Expert guidance on designing and implementing a security management system aligned with ISO 28000 requirements, including policies, procedures, and operational controls.</p></div><div class="p-6 bg-white rounded-2xl border border-slate-100 hover:border-euro-200 hover:shadow-lg transition-all duration-300 group"><div class="w-11 h-11 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 mb-4 group-hover:bg-euro-600 group-hover:text-white transition-all duration-300"><i class="fas fa-chalkboard-teacher text-base"></i></div><h4 class="heading-font text-[11px] font-bold uppercase tracking-widest text-slate-900 mb-2">Training &amp; Consultancy</h4><p class="text-slate-400 text-sm leading-relaxed">Comprehensive training programs on ISO 28000 requirements, supply chain security best practices, risk assessment methodologies, and security management for your teams.</p></div><div class="p-6 bg-white rounded-2xl border border-slate-100 hover:border-euro-200 hover:shadow-lg transition-all duration-300 group"><div class="w-11 h-11 rounded-xl bg-euro-50 flex items-center justify-center text-euro-600 mb-4 group-hover:bg-euro-600 group-hover:text-white transition-all duration-300"><i class="fas fa-headset text-base"></i></div><h4 class="heading-font text-[11px] font-bold uppercase tracking-widest text-slate-900 mb-2">Ongoing Compliance Support</h4><p class="text-slate-400 text-sm leading-relaxed">Continuous support to maintain ISO 28000 compliance including surveillance audit preparation, management review facilitation, and ongoing security improvement guidance.</p></div></div></div></section><section class="relative overflow-hidden"><div class="absolute inset-0 bg-[#030a16]"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,168,67,0.06)_0%,transparent_60%)]"></div><div class="relative z-10 py-14 lg:py-18"><div class="container mx-auto px-6"><div class="grid lg:grid-cols-5 gap-10 max-w-6xl mx-auto"><div class="lg:col-span-3"><h4 class="heading-font text-[11px] text-eurogold-400 tracking-[0.5em] uppercase mb-2 font-bold">Key Advantages</h4><h3 class="heading-font text-3xl md:text-4xl font-bold text-white tracking-tight mb-8">Why Get ISO 28000 Certified?</h3><div class="grid sm:grid-cols-2 gap-4"><div class="flex items-start gap-3 p-4 rounded-xl border border-white/5 bg-white/2 hover:bg-white/4 transition-colors"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0"><i class="fas fa-lock text-eurogold-400 text-xs"></i></div><div><h5 class="text-white font-bold text-xs uppercase tracking-wide heading-font mb-1">Enhanced Security</h5><p class="text-white/40 text-xs leading-relaxed">Improve the security of your supply chain operations with a structured, internationally recognized management system.</p></div></div><div class="flex items-start gap-3 p-4 rounded-xl border border-white/5 bg-white/2 hover:bg-white/4 transition-colors"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0"><i class="fas fa-shield-alt text-eurogold-400 text-xs"></i></div><div><h5 class="text-white font-bold text-xs uppercase tracking-wide heading-font mb-1">Risk Management</h5><p class="text-white/40 text-xs leading-relaxed">Systematically identify and mitigate security risks across your entire supply chain from end to end.</p></div></div><div class="flex items-start gap-3 p-4 rounded-xl border border-white/5 bg-white/2 hover:bg-white/4 transition-colors"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0"><i class="fas fa-balance-scale text-eurogold-400 text-xs"></i></div><div><h5 class="text-white font-bold text-xs uppercase tracking-wide heading-font mb-1">Regulatory Compliance</h5><p class="text-white/40 text-xs leading-relaxed">Meet security requirements and regulations applicable to your supply chain operations and trade activities.</p></div></div><div class="flex items-start gap-3 p-4 rounded-xl border border-white/5 bg-white/2 hover:bg-white/4 transition-colors"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0"><i class="fas fa-users text-eurogold-400 text-xs"></i></div><div><h5 class="text-white font-bold text-xs uppercase tracking-wide heading-font mb-1">Customer Confidence</h5><p class="text-white/40 text-xs leading-relaxed">Demonstrate your commitment to supply chain security, building trust with customers and business partners.</p></div></div><div class="flex items-start gap-3 p-4 rounded-xl border border-white/5 bg-white/2 hover:bg-white/4 transition-colors"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0"><i class="fas fa-trophy text-eurogold-400 text-xs"></i></div><div><h5 class="text-white font-bold text-xs uppercase tracking-wide heading-font mb-1">Competitive Advantage</h5><p class="text-white/40 text-xs leading-relaxed">Stand out as a secure and reliable business partner in the global supply chain marketplace.</p></div></div></div></div><div class="lg:col-span-2 p-8 rounded-2xl border border-white/5 bg-white/2 flex flex-col justify-center"><h3 class="heading-font text-2xl md:text-3xl font-bold text-white tracking-tight mb-4">Why Eurocert?</h3><p class="text-white/45 text-sm leading-relaxed mb-6">Our experienced auditors understand supply chain security requirements and can guide you through the certification process.</p><div class="grid grid-cols-2 gap-3"><div class="p-4 rounded-xl border border-eurogold-400/20 bg-eurogold-400/5 text-center"><span class="heading-font text-eurogold-400 font-bold text-3xl block mb-1 leading-none">25+</span><span class="text-[9px] font-bold text-white/50 uppercase tracking-[0.2em] heading-font">Years Experience</span></div><div class="p-4 rounded-xl border border-eurogold-400/20 bg-eurogold-400/5 text-center"><span class="heading-font text-eurogold-400 font-bold text-3xl block mb-1 leading-none">100%</span><span class="text-[9px] font-bold text-white/50 uppercase tracking-[0.2em] heading-font">Success Rate</span></div></div></div></div></div></div></section><section class="py-14 lg:py-18 bg-[#f8fafc]"><div class="container mx-auto px-6"><div class="text-center mb-8"><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-2 font-bold">Explore More</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">Related Certifications</h2></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-5 max-w-4xl mx-auto"><a class="group relative h-[280px] rounded-2xl overflow-hidden border border-slate-200 hover:border-euro-300 shadow-md hover:shadow-xl transition-all duration-500" href="/social/c-tpat"><div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image:url(&#x27;https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367934/eurocert/b9.png.png&#x27;)"></div><div class="absolute inset-0 bg-gradient-to-t from-[#030a16]/80 via-[#030a16]/20 to-transparent"></div><div class="absolute bottom-5 left-5 right-5 z-20"><h4 class="text-white text-sm heading-font font-bold uppercase tracking-widest mb-1">C-TPAT</h4><span class="text-[9px] font-bold uppercase text-eurogold-400 tracking-[0.2em] heading-font">Supply Chain Security</span></div></a><a class="group relative h-[280px] rounded-2xl overflow-hidden border border-slate-200 hover:border-euro-300 shadow-md hover:shadow-xl transition-all duration-500" href="/management-system/iso-9001"><div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image:url(&#x27;https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367536/eurocert/m2.png.png&#x27;)"></div><div class="absolute inset-0 bg-gradient-to-t from-[#030a16]/80 via-[#030a16]/20 to-transparent"></div><div class="absolute bottom-5 left-5 right-5 z-20"><h4 class="text-white text-sm heading-font font-bold uppercase tracking-widest mb-1">ISO 9001</h4><span class="text-[9px] font-bold uppercase text-eurogold-400 tracking-[0.2em] heading-font">Quality Management</span></div></a><a class="group relative h-[280px] rounded-2xl overflow-hidden border border-slate-200 hover:border-euro-300 shadow-md hover:shadow-xl transition-all duration-500" href="/management-system/iso-14001"><div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image:url(&#x27;https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367542/eurocert/m3.png.png&#x27;)"></div><div class="absolute inset-0 bg-gradient-to-t from-[#030a16]/80 via-[#030a16]/20 to-transparent"></div><div class="absolute bottom-5 left-5 right-5 z-20"><h4 class="text-white text-sm heading-font font-bold uppercase tracking-widest mb-1">ISO 14001</h4><span class="text-[9px] font-bold uppercase text-eurogold-400 tracking-[0.2em] heading-font">Environmental Management</span></div></a></div></div></section><section class="relative overflow-hidden"><div class="absolute inset-0 bg-[#030a16]"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(212,168,67,0.06)_0%,transparent_60%)]"></div><div class="relative z-10 py-14 lg:py-18"><div class="container mx-auto px-6 text-center"><div class="max-w-2xl mx-auto p-10 sm:p-12 rounded-2xl border border-white/5 bg-white/2"><h4 class="heading-font text-[11px] text-eurogold-400 tracking-[0.5em] uppercase mb-3 font-bold">Get Certified</h4><h2 class="heading-font text-2xl sm:text-3xl md:text-4xl font-bold text-white tracking-tight mb-4">Quick Inquiry</h2><p class="text-white/45 mb-6 max-w-lg mx-auto text-sm leading-relaxed">Our supply chain security experts are ready to guide your organization through ISO 28000 certification.</p><div class="flex flex-col sm:flex-row gap-3 justify-center"><a class="inline-flex items-center justify-center gap-2 heading-font text-[11px] font-bold uppercase tracking-[0.2em] text-[#030a16] bg-eurogold-400 rounded-full px-8 py-3.5 hover:bg-eurogold-300 transition-all shadow-lg shadow-eurogold-400/20" href="/contact">Get Started <i class="fas fa-arrow-right text-[9px]"></i></a><a href="tel:+919316012883" class="inline-flex items-center justify-center gap-2 heading-font text-[11px] font-bold uppercase tracking-[0.2em] text-white border border-white/15 rounded-full px-8 py-3.5 hover:bg-white/5 transition-all"><i class="fas fa-phone text-[9px]"></i> Call Us Now</a></div></div></div></div></section>
