---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="EUROCERT | Ctpat Login"
  description="Log in to the Eurocert C-TPAT client portal to access your supply chain security validation documents and certification program online."
  canonicalUrl="https://www.eurocert.asia/ctpat-login/"
  ogImage="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png"
  keywords="Eurocert,Eurocert Asia,ISO certification,CE marking,food safety certification,FSSC 22000,BRCGS,GFSI,social audits,Sedex,SMETA,SA8000,inspection services,certification body,India,management systems,ISO 9001,ISO 14001,ISO 45001"
>
<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<section class="relative pt-32 pb-12 bg-[#030a16] overflow-hidden"><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,168,67,0.08)_0%,transparent_60%)]"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(0,123,167,0.06)_0%,transparent_60%)]"></div><div class="relative z-10 container mx-auto px-6 text-center"><div class="flex items-center justify-center gap-6 mb-6"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367934/eurocert/b9.png.png" alt="C-TPAT Logo" class="h-16 md:h-20 object-contain"/><div class="w-px h-14 bg-white/20"></div><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367736/eurocert/ISO-28000-Logo-1.webp.webp" alt="ISO 28000 Logo" class="h-16 md:h-20 object-contain"/></div><h1 class="heading-font text-2xl md:text-3xl lg:text-4xl font-bold text-white tracking-tight">CTPAT AUDITS - ISO 28000 <span class="text-eurogold-400">Exchange Platform</span></h1><p class="text-white/80 text-sm mt-3 tracking-wide uppercase">Secure Supply Chain Compliance Portal</p></div></section><section class="py-14 lg:py-20"><div class="container mx-auto px-6"><div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-10 items-start"><div class="bg-white rounded-2xl border border-slate-100 shadow-xl p-8 md:p-10"><div class="mb-8"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png" alt="CTPAT-ISO 28000 Exchange Platform" class="h-14 object-contain"/></div><h2 class="heading-font text-2xl font-bold text-slate-900 tracking-tight mb-2">LOGIN</h2><p class="text-slate-400 text-sm mb-8">Access your CTPAT-ISO 28000 Exchange Platform account</p><form class="space-y-5"><div><label class="block text-[11px] font-bold text-slate-500 uppercase tracking-widest mb-2">Email</label><input type="email" required="" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-[#f8fafc] text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-euro-500/30 focus:border-euro-500 transition placeholder:text-slate-300" placeholder="Enter your email address" name="email" value=""/></div><div><label class="block text-[11px] font-bold text-slate-500 uppercase tracking-widest mb-2">Password</label><div class="relative"><input type="password" required="" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-[#f8fafc] text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-euro-500/30 focus:border-euro-500 transition placeholder:text-slate-300 pr-12" placeholder="Enter your password" name="password" value=""/><button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg></button></div></div><button type="submit" class="w-full py-3.5 rounded-xl bg-[#030a16] text-white font-bold text-sm uppercase tracking-widest hover:bg-slate-800 transition-all duration-300 shadow-lg hover:shadow-xl">Login</button><div class="flex items-center justify-between pt-2"><a class="text-euro-600 text-xs font-semibold hover:text-euro-700 transition" href="/ctpat-forgot-password">Forgot Password</a><a class="text-eurogold-600 text-xs font-semibold hover:text-eurogold-700 transition" href="/ctpat-register">Register</a></div></form></div><div class="space-y-6"><div class="relative overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-lg group hover:shadow-xl transition-all duration-300"><div class="absolute top-0 left-0 w-1.5 h-full bg-euro-600"></div><div class="p-8 md:p-10 pl-10"><div class="w-14 h-14 rounded-2xl bg-euro-50 flex items-center justify-center mb-6 group-hover:bg-euro-600 transition-all duration-300"><svg class="w-7 h-7 text-euro-600 group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg></div><h3 class="heading-font text-xl font-bold text-slate-900 uppercase tracking-wide mb-2">If You Are a Buyer..</h3><p class="text-slate-400 text-sm leading-relaxed mb-6">Register to access audit reports, manage your supply chain compliance, and connect with certified manufacturers on the platform.</p><a class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-euro-600 text-white text-xs font-bold uppercase tracking-widest hover:bg-euro-700 transition-all duration-300 shadow-md hover:shadow-lg" href="/ctpat-register">Register Now<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg></a><p class="text-slate-300 text-[11px] mt-3 uppercase tracking-widest font-medium">Get your login details</p></div></div><div class="relative overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-lg group hover:shadow-xl transition-all duration-300"><div class="absolute top-0 left-0 w-1.5 h-full bg-eurogold-500"></div><div class="p-8 md:p-10 pl-10"><div class="w-14 h-14 rounded-2xl bg-eurogold-50 flex items-center justify-center mb-6 group-hover:bg-eurogold-500 transition-all duration-300"><svg class="w-7 h-7 text-eurogold-600 group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg></div><h3 class="heading-font text-xl font-bold text-slate-900 uppercase tracking-wide mb-2">If You Are a Manufacturer..</h3><p class="text-slate-400 text-sm leading-relaxed mb-6">Register to showcase your CTPAT compliance, share ISO 28000 audit results, and connect with global buyers seeking certified supply chain partners.</p><a class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#030a16] text-eurogold-400 text-xs font-bold uppercase tracking-widest hover:bg-slate-800 transition-all duration-300 shadow-md hover:shadow-lg border border-eurogold-400/20" href="/ctpat-register">Register Now<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg></a><p class="text-slate-300 text-[11px] mt-3 uppercase tracking-widest font-medium">Get your login details</p></div></div></div></div></div></section>
</BaseLayout>
