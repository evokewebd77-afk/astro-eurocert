---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Certified Clients | Eurocert Asia"
  description="Explore Eurocert certified clients and verification resources for organizations assessed through Eurocert certification, inspection and audit services."
  canonicalUrl="https://www.eurocert.asia/certified-clients/"
  ogImage="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png"
  keywords="Eurocert,Eurocert Asia,ISO certification,CE marking,food safety certification,FSSC 22000,BRCGS,GFSI,social audits,Sedex,SMETA,SA8000,inspection services,certification body,India,management systems,ISO 9001,ISO 14001,ISO 45001"
>
<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden bg-[#030a16]"><div class="absolute inset-0 z-0"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782368140/eurocert/l1.png.png" alt="Certified Clients" class="w-full h-full object-cover"/><div class="absolute inset-0 bg-gradient-to-t from-[#030a16] via-[#030a16]/70 to-[#030a16]/40"></div></div><div class="container mx-auto px-6 relative z-10 text-center py-20"><div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-eurogold-400/30 bg-eurogold-400/5 backdrop-blur-sm mb-6"><span class="w-1.5 h-1.5 rounded-full bg-eurogold-400 animate-pulse"></span><span class="heading-font text-[10px] text-eurogold-400 tracking-[0.3em] uppercase font-bold">Our Clients</span></div><h1 class="heading-font text-4xl sm:text-6xl md:text-7xl font-bold text-white mb-3 tracking-tight" style="text-shadow:0 0 30px rgba(212,168,67,0.3)">Certified <span class="text-eurogold-400">Clients</span></h1><div class="flex items-center justify-center gap-2 text-white/80 text-sm heading-font mt-4"><span class="text-white/70">Certified Clients</span></div></div></section><section class="py-14 lg:py-18 bg-white"><div class="container mx-auto px-6"><div class="max-w-5xl mx-auto"><div class="text-center mb-10"><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-2 font-bold">Trusted Partners</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">Organizations We&#x27;ve Certified</h2><p class="text-slate-400 text-sm mt-3 max-w-2xl mx-auto">Eurocert has certified 1000+ clients across three continents, spanning diverse industries and sectors.</p></div><div class="grid grid-cols-2 sm:grid-cols-4 gap-5 mb-10"><div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] text-center"><span class="heading-font text-2xl md:text-3xl font-bold text-euro-600 block mb-1">1000+</span><span class="text-slate-400 text-[10px] uppercase tracking-[0.2em] heading-font font-bold">Registered Clients</span></div><div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] text-center"><span class="heading-font text-2xl md:text-3xl font-bold text-euro-600 block mb-1">3</span><span class="text-slate-400 text-[10px] uppercase tracking-[0.2em] heading-font font-bold">Continents</span></div><div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] text-center"><span class="heading-font text-2xl md:text-3xl font-bold text-euro-600 block mb-1">50+</span><span class="text-slate-400 text-[10px] uppercase tracking-[0.2em] heading-font font-bold">Certification Types</span></div><div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] text-center"><span class="heading-font text-2xl md:text-3xl font-bold text-euro-600 block mb-1">25+</span><span class="text-slate-400 text-[10px] uppercase tracking-[0.2em] heading-font font-bold">Years Experience</span></div></div><div class="mb-10"><h3 class="heading-font text-xl md:text-2xl font-bold text-slate-900 mb-6">Certified Clients Register</h3><div class="space-y-6"></div><div class="p-12 text-center rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50"><i class="fas fa-users text-slate-300 text-4xl mb-4"></i><p class="text-slate-400 text-sm">No certified clients registered yet.</p></div></div><div class="p-8 rounded-2xl border border-euro-100 bg-euro-50/30 text-center"><div class="w-14 h-14 rounded-2xl bg-euro-600 flex items-center justify-center mx-auto mb-4"><i class="fas fa-users text-white text-xl"></i></div><h3 class="heading-font text-lg font-bold text-slate-900 mb-2">Client Directory</h3><p class="text-slate-400 text-sm max-w-lg mx-auto mb-6">For a detailed list of our certified clients or to verify a certification, please contact our team directly.</p><a class="inline-flex items-center justify-center gap-2 heading-font text-[11px] font-bold uppercase tracking-[0.2em] text-white bg-euro-600 rounded-full px-8 py-3.5 hover:bg-euro-700 transition-all shadow-lg" href="/contact/">Request Client List <i class="fas fa-arrow-right text-[9px]"></i></a></div></div></div></section>
</BaseLayout>
