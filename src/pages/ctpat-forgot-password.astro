---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="EUROCERT | Ctpat Forgot Password"
  description="Reset your password to access the Eurocert C-TPAT client portal and manage your customs-trade partnership against terrorism validation services."
  canonicalUrl="https://www.eurocert.asia/ctpat-forgot-password/"
  ogImage="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png"
  keywords="Eurocert,Eurocert Asia,ISO certification,CE marking,food safety certification,FSSC 22000,BRCGS,GFSI,social audits,Sedex,SMETA,SA8000,inspection services,certification body,India,management systems,ISO 9001,ISO 14001,ISO 45001"
>
<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<section class="relative pt-32 pb-12 bg-[#030a16] overflow-hidden"><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,168,67,0.08)_0%,transparent_60%)]"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(0,123,167,0.06)_0%,transparent_60%)]"></div><div class="relative z-10 container mx-auto px-6 text-center"><div class="flex items-center justify-center gap-6 mb-6"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367934/eurocert/b9.png.png" alt="C-TPAT Logo" class="h-16 md:h-20 object-contain"/><div class="w-px h-14 bg-white/20"></div><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367736/eurocert/ISO-28000-Logo-1.webp.webp" alt="ISO 28000 Logo" class="h-16 md:h-20 object-contain"/></div><h1 class="heading-font text-2xl md:text-3xl lg:text-4xl font-bold text-white tracking-tight">CTPAT AUDITS - ISO 28000 <span class="text-eurogold-400">Exchange Platform</span></h1><p class="text-white/80 text-sm mt-3 tracking-wide uppercase">Password Recovery</p></div></section><section class="py-14 lg:py-20"><div class="container mx-auto px-6"><div class="max-w-md mx-auto"><div class="bg-white rounded-2xl border border-slate-100 shadow-xl p-8 md:p-10"><div class="mb-6"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png" alt="CTPAT-ISO 28000 Exchange Platform" class="h-14 object-contain"/></div><h2 class="heading-font text-2xl font-bold text-slate-900 tracking-tight mb-1">Forgot Password</h2><p class="text-slate-400 text-sm mb-8">Enter your email address and we&#x27;ll send you a link to reset your password.</p><form class="space-y-5"><div><label class="block text-[11px] font-bold text-slate-500 uppercase tracking-widest mb-2">Email</label><input type="email" required="" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-[#f8fafc] text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-euro-500/30 focus:border-euro-500 transition placeholder:text-slate-300" placeholder="Enter your registered email" value=""/></div><button type="submit" class="w-full py-3.5 rounded-xl bg-[#030a16] text-white font-bold text-sm uppercase tracking-widest hover:bg-slate-800 transition-all duration-300 shadow-lg hover:shadow-xl">Reset Password</button></form><div class="text-center pt-6 mt-6 border-t border-slate-100"><p class="text-slate-400 text-sm">Remember your password?<!-- --> <a class="text-euro-600 font-semibold hover:text-euro-700 transition" href="/ctpat-login/">Sign In</a></p></div></div></div></div></section>
</BaseLayout>
