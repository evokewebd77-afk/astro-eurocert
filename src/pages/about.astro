---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Eurocert | Inspection, Audit & Certification Body"
  description="Learn about Eurocert Inspection Services \u2014 our mission, accreditation, global presence and commitment to quality certification."
  canonicalUrl="https://www.eurocert.asia/about/"
  ogImage="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png"
  keywords="Eurocert,Eurocert Asia,ISO certification,CE marking,food safety certification,FSSC 22000,BRCGS,GFSI,social audits,Sedex,SMETA,SA8000,inspection services,certification body,India,management systems,ISO 9001,ISO 14001,ISO 45001"
>
<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<section class="relative min-h-[55vh] flex items-center justify-center overflow-hidden bg-[#030a16]"><div class="absolute inset-0 z-0"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782368082/eurocert/h0.png.png" class="w-full h-full object-cover opacity-30" alt="About Eurocert Asia"/><div class="absolute inset-0 bg-gradient-to-b from-[#030a16]/70 via-[#030a16]/40 to-[#030a16]"></div></div><div class="container mx-auto px-6 relative z-10 text-center py-20"><div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-eurogold-400/30 bg-eurogold-400/5 mb-6"><span class="w-1.5 h-1.5 rounded-full bg-eurogold-400 animate-pulse"></span><span class="heading-font text-[10px] text-eurogold-400 tracking-[0.3em] uppercase font-bold">Established 1998 — Global Certification Network</span></div><h1 class="heading-font text-4xl sm:text-6xl md:text-7xl font-bold text-white mb-3 tracking-tight" style="text-shadow:0 0 30px rgba(212,168,67,0.3)">About <span class="text-eurogold-400">Eurocert Asia</span></h1><p class="text-white/90 text-sm md:text-base max-w-2xl mx-auto leading-relaxed">A leading independent third-party certification, compliance, audit, and inspection body</p></div></section><section class="py-14 lg:py-18 bg-white"><div class="container mx-auto px-6"><div class="grid lg:grid-cols-5 gap-12 lg:gap-16 items-center"><div class="lg:col-span-3 space-y-6"><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase font-bold">Who We Are</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight">Eurocert Inspection <span class="text-euro-600">Services Pvt. Ltd.</span></h2><p class="text-slate-500 text-[15px] leading-relaxed">Eurocert Asia — officially operating as Eurocert Inspection Services Pvt. Ltd. — is a leading independent third-party certification, compliance, audit, and inspection body headquartered in Panchkula, Haryana, India. It is part of the global Eurocert network, whose parent certification body (Eurocert SA) was established in 1998 in Athens, Greece.</p><p class="text-slate-500 text-[15px] leading-relaxed">Eurocert Asia helps businesses of all sizes meet international regulatory, quality, social accountability, and sustainability standards — enabling access to new markets, stronger reputation, and continued growth. Its team comprises highly qualified auditors and specialists trained across India, Asia, and Europe in fields such as law, management, human resources, and industry compliance.</p></div><div class="lg:col-span-2 relative rounded-2xl overflow-hidden shadow-xl border border-slate-100 h-[320px] md:h-[400px] group"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367863/eurocert/a1.png.png" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" alt="Eurocert Asia"/><div class="absolute inset-0 bg-gradient-to-t from-slate-900/20 via-transparent to-transparent"></div></div></div></div></section><section class="py-14 lg:py-18 bg-[#f8fafc]"><div class="container mx-auto px-6"><div class="text-center mb-12"><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-3 font-bold">Our Services</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">What We <span class="text-euro-600">Do</span></h2><p class="text-slate-400 text-sm mt-3 max-w-xl mx-auto">Comprehensive certification and compliance services supporting organizations in demonstrating conformity with global standards</p></div><div class="grid md:grid-cols-3 gap-8"><div class="bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow duration-300"><div class="bg-[#030a16] px-6 py-5"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-eurogold-400/15 flex items-center justify-center shrink-0"><i class="fas fa-handshake text-eurogold-400 text-sm"></i></div><h3 class="heading-font text-sm font-bold text-white uppercase tracking-widest">Social &amp; Ethical Audits</h3></div></div><div class="p-6 space-y-5"><div><h4 class="heading-font text-sm font-bold text-slate-800 uppercase tracking-wider mb-1">SEDEX / SMETA Audits</h4><p class="text-slate-500 text-[13px] leading-relaxed">Ethical supply-chain audits focusing on labour standards, working conditions, health &amp; safety, and environmental compliance.</p></div><div><h4 class="heading-font text-sm font-bold text-slate-800 uppercase tracking-wider mb-1">SA8000 Certification</h4><p class="text-slate-500 text-[13px] leading-relaxed">An internationally recognized standard for social accountability, ensuring fair labour practices and worker welfare.</p></div></div></div><div class="bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow duration-300"><div class="bg-[#030a16] px-6 py-5"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-eurogold-400/15 flex items-center justify-center shrink-0"><i class="fas fa-shield-alt text-eurogold-400 text-sm"></i></div><h3 class="heading-font text-sm font-bold text-white uppercase tracking-widest">Quality, Safety &amp; Product Certifications</h3></div></div><div class="p-6 space-y-5"><div><h4 class="heading-font text-sm font-bold text-slate-800 uppercase tracking-wider mb-1">CE Marking Certification</h4><p class="text-slate-500 text-[13px] leading-relaxed">For products such as machinery, construction materials, lifts, pressure equipment, EN 1090, PED, ATEX and more.</p></div><div><h4 class="heading-font text-sm font-bold text-slate-800 uppercase tracking-wider mb-1">ISO Management System Certifications</h4><p class="text-slate-500 text-[13px] leading-relaxed">Including ISO 9001, ISO 14001, ISO 45001, ISO 50001, ISO 27001, and others.</p></div></div></div><div class="bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow duration-300"><div class="bg-[#030a16] px-6 py-5"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-eurogold-400/15 flex items-center justify-center shrink-0"><i class="fas fa-leaf text-eurogold-400 text-sm"></i></div><h3 class="heading-font text-sm font-bold text-white uppercase tracking-widest">Sustainability &amp; Sector-Specific Standards</h3></div></div><div class="p-6 space-y-5"><div><h4 class="heading-font text-sm font-bold text-slate-800 uppercase tracking-wider mb-1">Food Safety &amp; Agriculture</h4><p class="text-slate-500 text-[13px] leading-relaxed">FSSC 22000, HACCP, GLOBALGAP, IFS certifications for food safety and agricultural standards.</p></div><div><h4 class="heading-font text-sm font-bold text-slate-800 uppercase tracking-wider mb-1">Social &amp; Sustainability Standards</h4><p class="text-slate-500 text-[13px] leading-relaxed">WRAP, RMI, SLCP — social and sustainability certifications.</p></div><div><h4 class="heading-font text-sm font-bold text-slate-800 uppercase tracking-wider mb-1">Environmental Compliance</h4><p class="text-slate-500 text-[13px] leading-relaxed">Carbon footprint &amp; environmental compliance certifications.</p></div></div></div></div></div></section><section class="py-14 lg:py-18 bg-[#030a16] relative overflow-hidden"><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,168,67,0.06)_0%,transparent_60%)]"></div><div class="container mx-auto px-6 relative z-10"><div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center"><div><h4 class="heading-font text-[11px] text-eurogold-400 tracking-[0.5em] uppercase mb-3 font-bold">Why Us</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-white tracking-tight leading-tight mb-8">Why Choose <span class="text-eurogold-400">Eurocert Asia</span></h2><p class="text-white/50 text-[15px] leading-relaxed mb-8">Eurocert Asia partners with companies that want credible, globally recognized certification and independent audit reports. These qualities make Eurocert Asia a strategic partner for manufacturers, exporters, and service providers seeking international marketplace entry and compliance assurance.</p><div class="space-y-4"><div class="flex items-start gap-4 group"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-eurogold-400/20 transition"><i class="fas fa-check text-eurogold-400 text-[10px]"></i></div><p class="text-white/70 text-sm leading-relaxed group-hover:text-white/90 transition">Impartial and transparent certification services — based on a strict ethical code.</p></div><div class="flex items-start gap-4 group"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-eurogold-400/20 transition"><i class="fas fa-check text-eurogold-400 text-[10px]"></i></div><p class="text-white/70 text-sm leading-relaxed group-hover:text-white/90 transition">Globally accepted certificates and audits — trusted by international buyers and regulators.</p></div><div class="flex items-start gap-4 group"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-eurogold-400/20 transition"><i class="fas fa-check text-eurogold-400 text-[10px]"></i></div><p class="text-white/70 text-sm leading-relaxed group-hover:text-white/90 transition">Custom guidance &amp; support throughout the certification lifecycle.</p></div><div class="flex items-start gap-4 group"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-eurogold-400/20 transition"><i class="fas fa-check text-eurogold-400 text-[10px]"></i></div><p class="text-white/70 text-sm leading-relaxed group-hover:text-white/90 transition">Professional and experienced audit teams trained internationally.</p></div><div class="flex items-start gap-4 group"><div class="w-8 h-8 rounded-lg bg-eurogold-400/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-eurogold-400/20 transition"><i class="fas fa-check text-eurogold-400 text-[10px]"></i></div><p class="text-white/70 text-sm leading-relaxed group-hover:text-white/90 transition">Fast, reliable processes and responsive customer service.</p></div></div></div><div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-[0_0_60px_rgba(212,168,67,0.1)] h-[350px] md:h-[420px] group flex items-center justify-center bg-white/5"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png" class="w-full h-full object-contain p-4 transition-transform duration-700 group-hover:scale-105" alt="Why Eurocert"/><div class="absolute inset-0 bg-gradient-to-t from-[#030a16]/30 via-transparent to-transparent pointer-events-none"></div></div></div></div></section><section class="py-14 lg:py-18 bg-white"><div class="container mx-auto px-6"><div class="max-w-3xl mx-auto text-center"><div class="w-16 h-16 rounded-2xl bg-euro-600/10 flex items-center justify-center mx-auto mb-6"><i class="fas fa-bullseye text-euro-600 text-xl"></i></div><h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-3 font-bold">Our Purpose</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight mb-6">Our <span class="text-euro-600">Mission</span></h2><p class="text-slate-500 text-lg leading-relaxed">To empower businesses with clear guidance, fair and transparent audits, and globally recognized certifications — so they can build trust with clients, win contracts, and expand without barriers.</p></div></div></section><section class="py-14 lg:py-18 bg-[#030a16] relative overflow-hidden"><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(212,168,67,0.06)_0%,transparent_60%)]"></div><div class="container mx-auto px-6 relative z-10"><div class="max-w-3xl mx-auto text-center"><h4 class="heading-font text-[11px] text-eurogold-400 tracking-[0.5em] uppercase mb-3 font-bold">Get In Touch</h4><h2 class="heading-font text-3xl md:text-4xl font-bold text-white tracking-tight leading-tight mb-8">Contact &amp; <span class="text-eurogold-400">Headquarters</span></h2><div class="bg-white/5 border border-white/10 rounded-2xl p-8 md:p-10 space-y-5"><p class="text-white/80 text-base font-semibold">Eurocert Inspection Services Pvt. Ltd.</p><p class="text-white/50 text-sm leading-relaxed">304-Midtown Tower, Peer Muchalla,<br/>Panchkula, Haryana 134109, India</p><div class="flex flex-col sm:flex-row items-center justify-center gap-6 pt-2"><a href="tel:+919316012883" class="flex items-center gap-3 text-eurogold-400 hover:text-eurogold-300 transition"><div class="w-10 h-10 rounded-xl bg-eurogold-400/10 flex items-center justify-center"><i class="fas fa-phone-alt text-eurogold-400 text-sm"></i></div><span class="heading-font text-sm font-bold">+91-9316012883</span></a><a href="mailto:info@eurocert.in" class="flex items-center gap-3 text-eurogold-400 hover:text-eurogold-300 transition"><div class="w-10 h-10 rounded-xl bg-eurogold-400/10 flex items-center justify-center"><i class="fas fa-envelope text-eurogold-400 text-sm"></i></div><span class="heading-font text-sm font-bold">info@eurocert.in</span></a></div></div><a class="inline-flex items-center gap-3 heading-font text-[11px] font-bold uppercase tracking-[0.2em] text-eurogold-400 border border-eurogold-400/30 rounded-full px-8 py-4 hover:bg-eurogold-400/10 transition-all group mt-8" href="/contact">Contact Us <i class="fas fa-arrow-right text-[10px] transition-transform group-hover:translate-x-1"></i></a></div></div></section>
</BaseLayout>
