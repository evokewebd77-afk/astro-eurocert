<div class="bg-black py-2 px-4 md:px-6 border-b border-white/5 text-white relative z-[1200]">
  <div class="container mx-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] md:text-xs min-w-0">
      <a href="tel:+919316012883" class="flex items-center hover:text-eurogold-400 transition-colors shrink-0">
        <i class="fas fa-phone mr-2 text-eurogold-400" aria-hidden="true"></i>+91 9316012883
      </a>
      <a href="mailto:info@eurocert.in" class="flex items-center hover:text-eurogold-400 transition-colors shrink-0">
        <i class="fas fa-envelope mr-2 text-eurogold-400" aria-hidden="true"></i>info@eurocert.in
      </a>
      <span class="hidden md:flex items-center text-white/50 shrink-0">
        <i class="fas fa-map-marker-alt mr-2 text-eurogold-400/80" aria-hidden="true"></i>Panchkula, Haryana, India
      </span>
    </div>
    <div class="flex items-center gap-x-3 shrink-0">
      <a href="/ctpat-login/" class="flex items-center text-[10px] md:text-xs text-white/70 hover:text-eurogold-400 transition-colors shrink-0">
        <i class="fas fa-user-lock mr-1.5 text-eurogold-400/80" aria-hidden="true"></i>CTPAT Login
      </a>
      <a href="/ctpat-register/" class="flex items-center text-[10px] md:text-xs text-white/70 hover:text-eurogold-400 transition-colors shrink-0">
        <i class="fas fa-user-plus mr-1.5 text-eurogold-400/80" aria-hidden="true"></i>CTPAT Register
      </a>
      <button
      type="button"
      id="open-site-search-btn"
      class="shrink-0 flex items-center justify-center w-8 h-8 rounded-md border border-white/20 bg-white/5 text-eurogold-400 hover:bg-white/10 hover:border-eurogold-400/40 transition-colors"
      aria-expanded="false"
      aria-controls="site-search-modal"
      aria-label="Open search"
    >
      <i class="fas fa-search text-[11px]" aria-hidden="true"></i>
    </button>
  </div>
</div>
