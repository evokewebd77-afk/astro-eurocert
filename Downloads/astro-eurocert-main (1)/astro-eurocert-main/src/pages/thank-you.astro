---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="EUROCERT | Thank You"
  description="Thank you for contacting Eurocert. Our certification and inspection experts will respond to your enquiry about CE, ISO and food safety services."
  canonicalUrl="https://www.eurocert.asia/thank-you/"
  ogImage="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png"
  keywords="Eurocert,Eurocert Asia,ISO certification,CE marking,food safety certification,FSSC 22000,BRCGS,GFSI,social audits,Sedex,SMETA,SA8000,inspection services,certification body,India,management systems,ISO 9001,ISO 14001,ISO 45001"
>
<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden bg-[#030a16]"><div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(212,168,67,0.1)_0%,transparent_60%)]"></div><div class="container mx-auto px-6 relative z-10 py-14"><div class="max-w-3xl mx-auto bg-white rounded-3xl border border-slate-200 shadow-[0_32px_80px_-15px_rgba(0,0,0,0.2)] p-8 md:p-12 text-center"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.png" alt="Eurocert logo" class="h-14 md:h-16 w-auto mx-auto mb-5"/><div class="w-16 h-16 rounded-full bg-emerald-50 flex items-center justify-center mx-auto mb-4"><i class="fas fa-check text-emerald-600 text-2xl"></i></div><h1 class="heading-font text-3xl md:text-4xl text-slate-900 font-bold tracking-tight mb-3">Thank You</h1><p class="text-slate-600 text-base leading-relaxed max-w-2xl mx-auto mb-7">We will contact you soon. Till then, please revisit our website and explore more certification pages.</p><div class="flex flex-col sm:flex-row items-center justify-center gap-3"><a class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3 rounded-2xl bg-euro-600 text-white heading-font text-[11px] font-bold uppercase tracking-widest hover:bg-euro-700 transition" href="/">Home Page</a><a class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3 rounded-2xl border border-slate-200 text-slate-700 heading-font text-[11px] font-bold uppercase tracking-widest hover:bg-slate-50 transition" href="/management-systems/">See Another Page</a></div></div></div></section>
</BaseLayout>
