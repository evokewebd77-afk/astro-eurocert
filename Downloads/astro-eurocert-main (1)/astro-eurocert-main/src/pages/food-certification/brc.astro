id-cols-3 gap-5 max-w-4xl mx-auto"><a class="group relative h-[280px] rounded-2xl overflow-hidden border border-slate-200 hover:border-euro-300 shadow-md hover:shadow-xl transition-all duration-500" href="/food-certification/ifs/"><div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image:url(&#x27;https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367593/eurocert/F1.png.png&#x27;)"></div><div class="absolute inset-0 bg-gradient-to-t from-[#030a16]/80 via-[#030a16]/20 to-transparent"></div><div class="absolute bottom-5 left-5 right-5 z-20"><h4 class="text-white text-sm heading-font font-bold uppercase tracking-widest mb-1">IFS</h4><span class="text-[9px] font-bold uppercase text-eurogold-400 tracking-[0.2em] heading-font">International Featured Standards</span></div></a><a class="group relative h-[280px] rounded-2xl overflow-hidden border border-slate-200 hover:border-euro-300 shadow-md hover:shadow-xl transition-all duration-500" href="/food-certification/fssc-22000/"><div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image:url(&#x27;https://res.cloudinary.com/dwnnakrrh/image/upload/f_auto,q_auto:good,w_1600/v1782367669/eurocert/F4.png.png&#x27;)"></div><div class="absolute inset-0 bg-gradient-to-t from-[#030a16]/80 via-[#030a16]/20 to-transparent"></div><div class="absolute bottom-5 left-5 right-5 z-20"><h4 class="text-white text-sm heading-font font-bold uppercase tracking-widest mb-1">FSSC 22000</h4><span class="text-[9px] font-bold uppercase text-eurogold-400 tracking-[0.2em] heading-font">Food Safety System Certification</span></div></a><a class="group relative h-[280px] rounded-2xl overflow-hidden border border-slate-200 hover:border-euro-300 shadow-md hover:shadow-xl transition-all duration-500" href="/food-certification/haccp/"><div class="absolute inset-0 bg-cover bg-center transition-tr